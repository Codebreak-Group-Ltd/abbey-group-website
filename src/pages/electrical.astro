---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import Reviews from '../components/Reviews.astro';
import FAQ from '../components/FAQ.astro';
import Areas from '../components/Areas.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { nap, booking, routes, electricalReviews } from '../data/site.ts';
import { electricalFaqs } from '../data/faqs.ts';
import { service, faqPage, breadcrumb } from '../lib/schema.ts';
import { divisions } from '../data/divisions.ts';

/* Electrical — the one division where the client's real lockup exists, and the
   only page with NO photography at all. So it is built to work without photos
   rather than around placeholder boxes: credentials, prices and compliance
   facts carry the page, the real lockup appears once on a light ground where
   its navy wordmark reads, and the tri-tone green crescent does the decorative
   work. Swap in real shots per `06 Electrical/image-manifest.md` when they land.
   Copy: `06 Electrical/Text/Electrical - COPY.md` (Amy's confirmations, 21 July
   2026: NAPIT for electrical, City & Guilds, EICR £350 + VAT, EV chargers). */

const h1 = "Domestic & Commercial Electricians in Whitby";
const title = 'NAPIT Registered Electricians in Whitby | Abbey Group';
const description =
  'NAPIT registered, City & Guilds qualified electricians in Whitby. Rewiring, EICRs, EV chargers and fault-finding, domestic and commercial.';

const services = [
  { t: 'Domestic electrical', d: 'Sockets, lighting, consumer units and everything a home needs, done safely.' },
  { t: 'Commercial electrical', d: 'Electrical work for shops, guest houses, offices and other business premises.' },
  { t: 'Rewiring', d: 'Full and partial rewires, with as little disruption to the house as possible.' },
  { t: 'EICR and safety reports', d: 'Electrical Installation Condition Reports for landlords, buyers and peace of mind.' },
  { t: 'EV charger installation', d: 'Home charge points fitted safely and certified.' },
  { t: 'Fault-finding and repairs', d: 'Tracking down the cause and fixing it, not just papering over it.' },
];

/* Confirmed credentials only (Amy, 21 July 2026). NICEIC is NOT the body and is
   never named: the page brief flags it as a checkable claim. */
const credentials = [
  'NAPIT registered, so we can self-certify that electrical work meets Building Regulations Part P.',
  'City & Guilds qualified electricians.',
  'Signed off to the current wiring regulations.',
];

/* Each step is in the page copy already: the quick look that lets us quote, the
   fit, and certification. Nothing here is a new claim. */
const evSteps = [
  { t: 'A quick look', d: 'We see the property and the charger you have in mind, then quote it.' },
  { t: 'Fitted safely', d: 'The charge point goes in on your own drive, by a qualified electrician.' },
  { t: 'Certified', d: 'The work is certified and signed off, like any other electrical job we do.' },
];

/* Property types and the work, both straight from the commercial copy. */
const commercialTypes = ['Guest houses', 'Shops', 'Offices', 'Holiday lets'];
const commercialWork = ['Repairs', 'Rewires', 'Safety inspections and reports'];

const urgent = [
  'The line is open 24 hours a day, so you can always get through and leave a message.',
  'A real local person picks it up and gets to you as quickly as we can.',
  `The office is open ${nap.hours}.`,
];

/* The client-approved FAQ set for this page. It lives in `src/data/faqs.ts`
   because the page, its FAQPage JSON-LD and `/llms.txt` all read the same
   text and must never disagree. */
const faqs = electricalFaqs;

const schemas = [
  service({
    name: 'Electrical',
    path: routes.electrical,
    serviceType: 'Electricians, domestic and commercial',
    description,
  }),
  faqPage(faqs),
  breadcrumb([
    { name: 'Home', path: routes.home },
    { name: 'Electrical', path: routes.electrical },
  ]),
];
---
<BaseLayout title={title} description={description} schemas={schemas} division="electrical">
  <!-- Real hero photo landed 28 Aug 2026 — the first photograph this page has
       ever had. Only the hero is wired in: the 30 source photos this batch
       came with were all one electrician fitting a pendant light and a wall
       socket, so nothing here genuinely shows a consumer unit, an EICR test,
       an EV charger or a customer — those sections stay text/list-only until
       photos matching those specific categories exist (see image-manifest). -->
  <PageHero
    division="electrical"
    title={h1}
    lead="Certified electrical work for homes and businesses across Whitby, done safely by a local team. Whether you need an electrician in Whitby for a repair, a rewire or a landlord safety report, a real person answers and the work is signed off properly."
    trust={['NAPIT registered', 'City & Guilds qualified', 'Local', 'Rated 4.6 on Google']}
    image="/images/electrical-hero-electrician-working.webp"
    imageAlt="Abbey Group electrician fitting a light fixture in a Whitby property"
  >
    <!-- Navy, not orange: this hero sits on a green ground, and the two are
         near-complementary at full strength (Josh, 29 July 2026). Orange stays
         the action colour on this page's white and stone sections. -->
    <Button href={`tel:${nap.phone.tel}`} variant="navy" size="lg">Call the Whitby office</Button>
    <Button href={booking.quote} external variant="inverse-outline" size="lg">Get a Quote</Button>
  </PageHero>

  <!-- WHAT WE DO -->
  <Section bg="white">
    <!-- One grid for the whole section, so the credentials card can start at the
         section's top edge and sit BESIDE the heading rather than below it. It
         used to begin level with the service list, 164px down, which left it
         hanging past the bottom of the column and lined up with nothing
         (Josh, 30 July 2026). -->
    <div class="svc">
      <div class="svc__head reveal">
        <Eyebrow>What we do</Eyebrow>
        <h2 class="eh2">Electrical work for homes and businesses</h2>
      </div>
      <!-- The list and its CTA are one column, so the CTA sits directly under
           the last service instead of being pushed down by the taller card
           beside it, which left a hole in the middle of the section. -->
      <div class="svc__main reveal">
        <ul class="svc__grid">
          {services.map((s) => (
            <li class="svc__item">
              <span class="svc__chip"><Icon name="check" size={16} /></span>
              <div><strong>{s.t}.</strong> {s.d}</div>
            </li>
          ))}
        </ul>
        <div class="svc__cta">
          <Button href={booking.quote} external size="lg">Get a Quote</Button>
        </div>
      </div>

      <!-- The client's real Abbey Electrical lockup, used on a light ground
           because its wordmark is navy. Extracted from the supplied PDF at
           3375px, background removed, trimmed (see LAUNCH.md). -->
      <aside class="cred reveal">
        <img
          class="cred__logo"
          src="/brand/logos/abbey-electrical-lockup.webp"
          alt="Abbey Electrical"
          width="330"
          height="264"
          loading="lazy"
          decoding="async"
        />
        <p class="cred__lead">
          Electrical work is not the place to cut corners, so ours is carried out by a
          NAPIT registered, City &amp; Guilds qualified electrician and signed off to the
          current wiring regulations.
        </p>
        <ul class="cred__list">
          {credentials.map((c) => (
            <li><Icon name="badge-check" size={16} /><span>{c}</span></li>
          ))}
        </ul>
      </aside>
    </div>
  </Section>

  <!-- EMERGENCY -->
  <Section bg="dark" bleed>
    <div class="emg">
      <img class="emg__mark" src={divisions.electrical.mark} alt="" aria-hidden="true" width="380" height="399" />
      <div class="container emg__inner reveal">
        <div class="emg__copy">
          <Eyebrow tone="inverse">Emergency electrical</Eyebrow>
          <h2 class="emg__h2">Something not right with the electrics?</h2>
          <p class="emg__body">
            If you have lost power, or something is tripping, sparking or burning, call the
            Whitby office. A real local person takes the call and we get to you as quickly
            as we can, with urgent jobs prioritised.
          </p>
          <Button href={`tel:${nap.phone.tel}`} variant="navy" size="lg">Call now on {nap.phone.label}</Button>
        </div>
        <ul class="emg__facts">
          {urgent.map((u) => (
            <li><Icon name="clock" size={16} /><span>{u}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <!-- LANDLORD EICR — deliberately mirrors the landlord gas safety section on
       Plumbing & Heating: same audience, same compliance pattern. -->
  <Section bg="sunken">
    <div class="eicr">
      <!-- Eyebrow and heading are their own row, so the Q&A cards begin level
           with the lead paragraph rather than 160px higher, alongside the
           eyebrow, where they lined up with nothing (Josh, 30 July 2026). -->
      <div class="eicr__head reveal">
        <Eyebrow>Landlords</Eyebrow>
        <h2 class="eh2">Landlord electrical safety reports (EICR) in Whitby</h2>
      </div>
      <div class="eicr__copy reveal">
        <p class="eicr__lead">
          If you let a property, you must have the fixed wiring inspected and tested with
          an EICR (Electrical Installation Condition Report). We carry out the inspection,
          give you the certificate, and flag anything that needs putting right so your
          property stays safe and compliant.
        </p>
        <p class="eicr__price">An EICR is <strong>£350</strong> plus VAT (£420).</p>
        <Button href={booking.quote} external size="lg">Book an EICR</Button>
        <p class="eicr__xlink">
          Sorting your gas safety certificate too? We can handle both. See
          <a href={routes.plumbing}>Plumbing &amp; Heating</a> for combined landlord compliance.
        </p>
      </div>
      <ul class="eicr__qa reveal">
        <li>
          <h3>How often do I need an EICR?</h3>
          <p>At least every five years, and on a change of tenancy.</p>
        </li>
        <li>
          <h3>When do tenants get the report?</h3>
          <p>Existing tenants within 28 days of the inspection, and new tenants before they move in.</p>
        </li>
      </ul>
    </div>
  </Section>

  <!-- EV CHARGERS -->
  <Section bg="white">
    <!-- Same shape as the Landlords section above, and the same column ratio as
         every other two-column section on this page. The steps panel used to be
         the WIDER column (0.95fr / 1.05fr, the one section on the page reversed)
         and started level with the eyebrow, so it sat 62px further left and
         ~94px higher than its neighbours (Josh, 30 July 2026). -->
    <div class="ev">
      <div class="ev__head reveal">
        <Eyebrow>EV chargers</Eyebrow>
        <h2 class="eh2">Home EV charger installation</h2>
      </div>
      <p class="elead ev__lead reveal">
        We install home EV charge points, fitted safely and certified, so you can charge
        on your own drive. The price depends on your property and the charger, so we
        quote it after a quick look.
      </p>
      <!-- Three steps, each one traceable to the copy: a quick look to quote,
           the fit, then certification. Nothing invented. -->
      <ol class="ev__steps reveal">
        {evSteps.map((s, i) => (
          <li>
            <span class="ev__num" aria-hidden="true">{i + 1}</span>
            <div>
              <p class="ev__stept">{s.t}</p>
              <p class="ev__stepd">{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
      <!-- Inside column 1, so the note can never run underneath the steps panel:
           there is now a real column edge it cannot cross. -->
      <div class="ev__cta reveal">
        <!-- White ground, so orange: navy is only for the green grounds (the hero
             and the emergency band). -->
        <Button href={booking.quote} external size="lg">Ask About EV Chargers</Button>
        <p class="ev__ctanote">
          Adding a charger alongside other electrical work? We sort it all in one visit.
        </p>
      </div>
    </div>
  </Section>

  <!-- COMMERCIAL -->
  <Section bg="sunken">
    <div class="com">
      <div class="com__copy reveal">
        <Eyebrow>Business and commercial</Eyebrow>
        <h2 class="eh2">Electrical work for businesses and holiday lets</h2>
        <p class="elead">
          Guest house, shop, office or holiday let? We look after commercial electrical
          work and safety inspections across North Yorkshire, from repairs and rewires to
          the reports you need to stay compliant. Talk to us about a contract or a one-off
          job.
        </p>
      </div>
      <div class="com__side reveal">
        <p class="com__label">Properties we look after</p>
        <!-- Four types in a 2x2 grid: an even grid, not a wrapping row. -->
        <ul class="com__types">
          {commercialTypes.map((t) => <li>{t}</li>)}
        </ul>
        <p class="com__label com__label--spaced">The work</p>
        <ul class="com__work">
          {commercialWork.map((w) => (
            <li><Icon name="check" size={15} /><span>{w}</span></li>
          ))}
        </ul>
      </div>
      <!-- Moved INSIDE the grid, in column 1 (Josh, 30 July 2026). As a
           full-width row underneath, this note ran 166px past the start of the
           right-hand column and read as though it belonged to it. There is now a
           real column edge for it to respect. -->
      <div class="com__actions reveal">
        <Button href={`tel:${nap.phone.tel}`} size="lg">Talk to Us About Commercial Work</Button>
        <!-- Phone number never breaks across lines (standing rule 13). -->
        <p class="com__note">
          Call the Whitby office on <span class="tnum com__nowrap">{nap.phone.label}</span>, {nap.hours}.
        </p>
      </div>
    </div>
  </Section>

  <!-- WHY PEOPLE CHOOSE ABBEY -->
  <Reviews
    eyebrow="Why people choose Abbey"
    heading="Certified, safe, and local"
    reviews={electricalReviews}
    bg="white"
  />

  <!-- AREAS -->
  <Areas heading="Electrical work across Whitby and the coast" bg="sunken" division="electrical">
    These are the places we are called out to most often:
  </Areas>

  <!-- FAQ -->
  <FAQ heading="Electrical questions, answered" items={faqs} bg="white" />

  <!-- ENQUIRY -->
  <EnquiryForm
    heading="Get it booked, or get a quote"
    lead="Call the Whitby office for anything urgent, or leave your details and we will get back to you with a quote."
    source="Electrical"
    tags="electrical,quote"
    submitLabel="Get a Quote"
    bg="sunken"
    fields={[
      { name: 'name', label: 'Name', required: true, autocomplete: 'name' },
      { name: 'phone', label: 'Phone', type: 'tel', required: true, autocomplete: 'tel' },
      { name: 'email', label: 'Email', type: 'email', autocomplete: 'email' },
      { name: 'postcode', label: 'Postcode', autocomplete: 'postal-code' },
      { name: 'message', label: 'What you need', type: 'textarea', full: true },
    ]}
  >
    <div class="el-formside">
      <Button href={`tel:${nap.phone.tel}`} variant="outline" size="lg">Call the Whitby office</Button>
      <p class="el-formside__links">
        Need a gas safety certificate as well as an EICR? See
        <a href={routes.plumbing}>Plumbing &amp; Heating</a> for combined landlord compliance.
      </p>
    </div>
  </EnquiryForm>
</BaseLayout>

<style>
  .eh2 { font-size: clamp(32px, 3.2vw, 46px); color: var(--text-heading); margin-top: 10px; }
  .elead {
    margin-top: 16px;
    max-width: 62ch;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--text-body);
  }

  /* WHAT WE DO ---------------------------------------------------------- */
  /* Heading and list stack down column 1; the credentials card occupies the
     whole of column 2, so its top edge lines up with the first line of text in
     the section instead of with the service list 164px lower. */
  .svc {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    column-gap: 56px;
    align-items: start;
  }
  .svc__head { grid-column: 1; grid-row: 1; max-width: 640px; margin-bottom: 36px; }
  .svc__main { grid-column: 1; grid-row: 2; display: flex; flex-direction: column; }
  .cred { grid-column: 2; grid-row: 1 / span 2; align-self: start; }
  .svc__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px 32px; }
  .svc__item {
    display: flex; gap: 14px; align-items: flex-start;
    font-size: 15px; line-height: var(--leading-relaxed); color: var(--text-body);
  }
  .svc__item strong { color: var(--text-heading); }
  .svc__chip {
    display: inline-flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; flex: none;
    border-radius: var(--radius-signature);
    background: var(--page-accent-soft);
    color: var(--page-accent-ink);
    margin-top: 2px;
  }
  .svc__cta { margin-top: 32px; }

  /* CREDENTIALS CARD (carries the real lockup) -------------------------- */
  .cred {
    background: var(--surface-sunken);
    border: 1px solid var(--border-subtle);
    border-top: 3px solid var(--page-accent);
    border-radius: var(--radius-lg);
    padding: 28px 28px 30px;
  }
  .cred__logo { width: 220px; height: auto; margin-bottom: 20px; }
  .cred__lead {
    font-size: 15.5px;
    line-height: var(--leading-relaxed);
    color: var(--text-body);
  }
  .cred__list {
    display: flex; flex-direction: column; gap: 12px;
    margin-top: 20px; padding-top: 20px;
    border-top: 1px solid var(--border-subtle);
  }
  .cred__list li {
    display: flex; gap: 10px; align-items: flex-start;
    font-size: 14.5px; line-height: var(--leading-snug); color: var(--text-body);
  }
  .cred__list :global(svg) { color: var(--page-accent-ink); flex: none; margin-top: 1px; }

  /* EMERGENCY ----------------------------------------------------------- */
  .emg {
    position: relative;
    overflow: hidden;
    padding-block: 84px;
    background:
      radial-gradient(900px 580px at 84% 22%, color-mix(in oklch, var(--page-accent-glow) 55%, transparent) 0%, transparent 65%),
      var(--surface-page-dark);
  }
  .emg__mark {
    position: absolute; left: -110px; top: 50%; transform: translateY(-50%);
    width: 380px; opacity: 0.12; pointer-events: none;
  }
  .emg__inner {
    position: relative;
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: center;
  }
  .emg__copy { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .emg__h2 {
    font-family: var(--font-display);
    font-size: clamp(30px, 3vw, 44px);
    color: var(--white);
    text-wrap: balance;
  }
  .emg__body {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--text-body-inverse);
    max-width: 54ch;
  }
  .emg__facts {
    display: flex; flex-direction: column; gap: 14px;
    background: color-mix(in oklch, var(--white) 7%, transparent);
    border: 1px solid var(--border-inverse);
    border-radius: var(--radius-xl);
    padding: 26px 28px;
    backdrop-filter: blur(6px);
  }
  .emg__facts li {
    display: flex; gap: 12px; align-items: flex-start;
    font-size: 15px; line-height: var(--leading-snug); color: var(--text-body-inverse);
  }
  /* The pale logo green, not the main one: it is 7.15:1 on this ground. */
  .emg__facts :global(svg) { color: var(--green-300); flex: none; margin-top: 2px; }

  /* LANDLORD EICR ------------------------------------------------------- */
  /* Heading owns row 1 of column 1; the body copy and the Q&A cards share row 2,
     so both columns start on the same line. */
  .eicr {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    column-gap: 56px;
    align-items: start;
  }
  .eicr__head { grid-column: 1; grid-row: 1; margin-bottom: 22px; }
  .eicr__copy { grid-column: 1; grid-row: 2; display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .eicr__qa { grid-column: 2; grid-row: 2; }
  .eicr__lead, .eicr__price {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-body);
  }
  .eicr__price strong { font-size: var(--text-lg); color: var(--text-heading); }
  .eicr__xlink { font-size: var(--text-sm); color: var(--text-muted); max-width: 52ch; }
  .eicr__xlink a { color: var(--text-link); font-weight: var(--weight-semibold); text-decoration: underline; }
  .eicr__qa { display: flex; flex-direction: column; gap: 16px; align-self: start; }
  .eicr__qa li {
    background: var(--white);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 22px 24px;
  }
  .eicr__qa h3 {
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    color: var(--text-heading);
    margin-bottom: 8px;
  }
  .eicr__qa p { font-size: 14.5px; line-height: var(--leading-relaxed); color: var(--text-body); }

  /* EV CHARGERS --------------------------------------------------------- */
  /* 1.05fr / 0.95fr now, matching the Landlords and Commercial sections above
     and below it, and rows rather than vertical centring so the steps panel
     starts on the lead paragraph's line. */
  .ev {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    column-gap: 56px;
    align-items: start;
  }
  /* The gap between heading and lead lives on the HEADING, not as a margin-top
     on the lead: a margin-top would push the lead down inside row 2 while the
     steps panel stayed at the row's top edge, and the two would miss each other
     by exactly that much. */
  .ev__head { grid-column: 1; grid-row: 1; margin-bottom: 18px; }
  .ev__lead { grid-column: 1; grid-row: 2; margin-top: 0; }
  .ev__cta { grid-column: 1; grid-row: 3; }
  /* Three numbered steps on a green-tinted panel: the section needed a shape,
     and the sequence is the thing people actually want to know. */
  .ev__steps {
    grid-column: 2;
    grid-row: 2 / span 2;
    align-self: start;
    display: grid;
    gap: 2px;
    background: color-mix(in oklch, var(--page-accent) 22%, transparent);
    border-radius: var(--radius-xl);
    padding: 2px;
    overflow: hidden;
  }
  .ev__steps li {
    display: flex; gap: 18px; align-items: flex-start;
    background: var(--surface-page);
    padding: 22px 26px;
  }
  .ev__steps li:first-child { border-radius: 22px 22px 0 0; }
  .ev__steps li:last-child { border-radius: 0 0 22px 4px; }
  .ev__num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; flex: none;
    border-radius: var(--radius-pill);
    background: var(--page-accent);
    /* Navy glyph on the accent disc: the one colour legible on every division
       accent, this green included (6.60:1). */
    color: var(--ink-500);
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 1;
  }
  .ev__stept { font-size: var(--text-md); font-weight: var(--weight-semibold); color: var(--text-heading); }
  .ev__stepd { margin-top: 4px; font-size: 15px; line-height: var(--leading-relaxed); color: var(--text-body); }
  /* Stacked inside the column rather than a wide button-plus-note row: at 643px
     the two will not sit side by side without squeezing the note to three
     lines. */
  .ev__cta { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; margin-top: 34px; }
  .ev__ctanote { font-size: var(--text-sm); color: var(--text-muted); max-width: 52ch; }

  /* COMMERCIAL ---------------------------------------------------------- */
  .com {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    column-gap: 56px;
    align-items: start;
  }
  .com__copy { grid-column: 1; grid-row: 1; }
  .com__side { grid-column: 2; grid-row: 1 / span 2; align-self: start; }
  .com__actions { grid-column: 1; grid-row: 2; }
  .com__label {
    font-size: 12.5px;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--page-accent-ink);
  }
  .com__label--spaced { margin-top: 26px; }
  /* Four types, 2x2: an even grid rather than a wrapping row. */
