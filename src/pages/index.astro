---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import DivisionSlot from '../components/DivisionSlot.astro';
import HeroMark from '../components/HeroMark.astro';
import Photo from '../components/Photo.astro';
import Reviews from '../components/Reviews.astro';
import FAQ from '../components/FAQ.astro';
import Areas from '../components/Areas.astro';
import { nap, booking, routes, homeReviews } from '../data/site.ts';
import { homeFaqs } from '../data/faqs.ts';
import { localBusiness, faqPage, breadcrumb } from '../lib/schema.ts';
import type { DivisionKey } from '../data/divisions.ts';

const title = 'Abbey Group Whitby | Plumbing, Heating & Home Services';
const description =
  "Whitby's one local team for plumbing, heating, renovations, building and electrical work. Gas Safe registered and local. Homecare plans from £9.99 a month.";

type DivisionCard = {
  title: string;
  href: string;
  icon: string;
  accent: string;
  ink: string;
  desc: string;
  link: string;
  /** Photograph for the card, or null where none exists yet. */
  img: string | null;
  /** Alt text for the photo, or the caption for the stand-in. */
  photo: string;
  /** Designed stand-in used when `img` is null (see DivisionSlot.astro). */
  slot?: { division: DivisionKey; label: string; sub?: string };
};

const divisions: DivisionCard[] = [
  {
    title: 'Homecare Plans', href: routes.homecare, icon: 'shield-check', accent: 'var(--accent-care)', ink: 'var(--accent-care-ink)',
    desc: 'Boiler cover from £9.99 a month. Your annual service, gas safety certificate and priority response, sorted.',
    link: 'Compare the Plans', img: '/images/card-homecare.webp', photo: 'Abbey Group Homecare Plans in Whitby',
  },
  {
    title: 'Plumbing & Heating', href: routes.plumbing, icon: 'flame', accent: 'var(--accent-plumbing)', ink: 'var(--accent-plumbing-ink)',
    desc: 'Boilers, heating, repairs and emergencies from a local Gas Safe team.',
    link: 'Explore Plumbing & Heating', img: '/images/card-plumbing.webp', photo: 'An Abbey Group branded van near Whitby Abbey',
  },
  {
    title: 'Renovations', href: routes.renovations, icon: 'paintbrush', accent: 'var(--accent-joinery)', ink: 'var(--accent-joinery-ink)',
    desc: 'Kitchens, bathrooms and extensions, project-managed from first drawing to final clean.',
    link: 'See Our Renovations', img: '/images/card-renovations.webp', photo: 'A finished Abbey Group kitchen renovation in Whitby',
  },
  {
    title: 'Building & Joinery', href: routes.joinery, icon: 'ruler', accent: 'var(--accent-joinery)', ink: 'var(--accent-joinery-ink)',
    desc: 'Structural building work and bespoke joinery, made and fitted properly.',
    link: 'Explore Building & Joinery', img: '/images/card-joinery.webp', photo: 'Abbey Group building and joinery work in Whitby',
  },
  {
    // Greens corrected to the real Abbey Electrical logo (29 July 2026): the
    // card tab and chip tint take the logo's main green, and the icon and link
    // text take --green-ink, which is now the dark end of that same family
    // rather than an olive stand-in.
    // No photograph exists for this trade at all (outstanding §C1), so the card
    // carries a designed division panel with a real credential on it rather
    // than a hatched placeholder or stock. Give it an `img` and it renders a
    // photo like the other five, no other change needed.
    title: 'Electrical', href: routes.electrical, icon: 'zap', accent: 'var(--accent-electrical)', ink: 'var(--green-ink)',
    desc: 'Safe, certified electrical work for your home.',
    link: 'Explore Electrical', img: null, photo: 'Certified Abbey Group electrical work',
    slot: { division: 'electrical' as const, label: 'NAPIT registered', sub: 'Part P self-certified, City & Guilds qualified' },
  },
];

const proofs = [
  { icon: 'calendar-check', text: 'Fresh plastic sheeting goes down every Monday, and your house is handed back clean every Friday.' },
  { icon: 'truck', text: 'We hire and manage the skip, so it is one less thing on your plate.' },
  { icon: 'door-open', text: 'Twelve months after a new kitchen, we come back and check everything is still right.' },
  { icon: 'phone', text: 'One number, answered by Amy or Natasha in the Whitby office, so you talk to someone who knows your job.' },
];

/* The client-approved FAQ set for this page. It lives in `src/data/faqs.ts`
   because the page, its FAQPage JSON-LD and `/llms.txt` all read the same
   text and must never disagree. */
const faqs = homeFaqs;

const schemas = [
  localBusiness({ path: routes.home, description }),
  faqPage(faqs),
  breadcrumb([{ name: 'Home', path: routes.home }]),
];
---
<BaseLayout title={title} description={description} schemas={schemas}>
  <!-- 1. HERO -->
  <section class="hero">
    <!-- One soft white mark rather than the old tri-colour stack, which competed
         with the mark on the van's own livery (Josh, 29 July 2026) — but still
         three separate arcs, so they move independently under the pointer as
         they used to (Josh, 30 July 2026). Same component on every hero. -->
    <HeroMark tone="white" width={620} class="hero__crescent" />

    <div class="container hero__grid">
      <div class="hero__copy">
        <!-- No brand mark here: the lockup sits top-left already, and the two
             were close on desktop and closer still on mobile. -->
        <p class="hero__eyebrow">One team, every trade</p>
        <h1 class="hero__h1">One Local Team for Everything Your Home Needs</h1>
        <p class="hero__lead">
          Boilers, heating, kitchens, bathrooms, extensions and the everyday repairs in
          between. Abbey Group is Whitby's one-stop home services team, and homecare plans
          start at £9.99 a month. One call, and it is handled.
        </p>
        <div class="hero__cta">
          <Button href={routes.homecare} size="lg">See the Homecare Plans</Button>
          <Button href={booking.quote} external variant="inverse-outline" size="lg">Get a Quote</Button>
        </div>
        <p class="hero__reassure">
          Call
          <a class="tnum" href={`tel:${nap.phone.tel}`}>{nap.phone.label}</a>, and a real person answers.
        </p>
      </div>

    </div>

    <!-- The van is the hero visual and drives off to the right as you scroll.
         It faces right, as supplied, so it exits right: mirroring the photo
         would reverse the ABBEY GROUP wordmark on the side. The hero clips it,
         so it can never cause horizontal overflow. -->
    <div class="hero__van" data-van>
      <img
        src="/images/van-side.webp"
        alt="An Abbey Group branded van"
        width="1302"
        height="475"
        loading="eager"
        fetchpriority="high"
        decoding="auto"
      />
    </div>
  </section>

  <!-- 2. TRUST STRIP -->
  <Section bg="white" pad="tight" borderBottom>
    <ul class="trust">
      <li><Icon name="star" size={18} /><span>Rated 4.6 on Google by local customers</span></li>
      <li><Icon name="shield-check" size={18} /><span>Gas Safe registered, No. 303376</span></li>
      <li><Icon name="wrench" size={18} /><span>One team, every trade</span></li>
      <li><Icon name="map-pin" size={18} /><span>Serving Whitby and the surrounding villages</span></li>
    </ul>
  </Section>

  <!-- 3. WHAT WE DO -->
  <Section bg="sunken">
    <div class="dv__head reveal">
      <div>
        <Eyebrow>What we do</Eyebrow>
        <h2 class="h2">Whatever your house needs, it is one call</h2>
      </div>
      <p class="dv__intro">
        Yes, one local company in Whitby covers boiler cover, plumbing, heating,
        renovations, building, joinery and electrical work. You do not need to line up
        separate trades and hope they turn up in the right order. We handle it.
      </p>
    </div>

    <ul class="dv__grid reveal">
      {divisions.map((d) => (
        <li>
          <a class="dv__card" href={d.href} style={`--accent:${d.accent};--accent-ink:${d.ink}`}>
            <span class="dv__bar" aria-hidden="true"></span>
            {d.img
              ? <Photo src={d.img} alt={d.photo} ratio="16 / 9" radius="none" bordered={false} width={840} height={472} class="dv__photo" />
              : d.slot
                ? <DivisionSlot division={d.slot.division} label={d.slot.label} sub={d.slot.sub} class="dv__photo" />
                : <PhotoSlot ratio="16 / 9" radius="none" caption={d.photo} bordered={false} class="dv__photo" />}
            <div class="dv__body">
              <div class="dv__titlerow">
                <span class="dv__chip"><Icon name={d.icon} size={17} /></span>
                <h3 class="dv__title">{d.title}</h3>
              </div>
              <p class="dv__desc">{d.desc}</p>
              <span class="dv__link">{d.link} <Icon name="arrow-right" size={14} /></span>
            </div>
          </a>
        </li>
      ))}

      <!-- Sixth tile: fills the grid and catches everything not listed above,
           using the Group tri-colour mark to tie the five divisions together. -->
      <li>
        <a class="dv__card dv__card--group" href={`tel:${nap.phone.tel}`}>
          <img class="dv__groupmark" src="/brand/crescent/crescent-mark.svg" alt="" aria-hidden="true" width="260" height="273" />
          <div class="dv__groupbody">
            <h3 class="dv__grouptitle">Something else?</h3>
            <p class="dv__groupdesc">
              If it is a job around the house and it is not on this list, ring the office
              and we will sort it.
            </p>
            <span class="dv__grouplink tnum">
              <Icon name="phone" size={15} /> {nap.phone.label}
            </span>
          </div>
        </a>
      </li>
    </ul>
  </Section>

  <!-- 4. WHY PEOPLE STAY -->
  <Section bg="white">
    <div class="way">
      <div class="way__left reveal">
        <Eyebrow>Why people stay with us</Eyebrow>
        <h2 class="h2" style="text-wrap:balance">We do the things you would only notice if we did not</h2>
        <p class="way__intro">The work speaks for itself, but it is how we work that people remember.</p>
        <blockquote class="way__quote">
          Most of our customers stay with us for more than 15 years, and in all that time
          we have had one cancellation.
        </blockquote>
      </div>
      <ul class="way__grid reveal">
        {proofs.map((p) => (
          <li class="way__card">
            <span class="way__chip"><Icon name={p.icon} size={18} /></span>
            <p>{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- 5. HOMECARE BANNER -->
  <Section bg="dark" bleed>
    <div class="hcb">
      <img class="hcb__mark" src="/brand/crescent/mark-homecare.svg" alt="" aria-hidden="true" width="380" height="399" />
      <div class="container hcb__inner reveal">
        <h2 class="hcb__h2">Never face a broken boiler alone again</h2>
        <p class="hcb__body">
          For <span class="hcb__price tnum">£9.99</span> a month, your boiler is serviced,
          safety-checked and looked after by a local team, with priority response when you
          need it. It is the easiest way to stop worrying about the heating.
        </p>
        <Button href={routes.homecare} size="lg">See What's Included</Button>
      </div>
    </div>
  </Section>

  <!-- 6. REVIEWS -->
  <Reviews heading="What Whitby says about us" reviews={homeReviews} bg="white" />

  <!-- 7. AREAS WE COVER -->
  <Areas heading="Where we work across Whitby and the coast" bg="sunken">
    One local team covering Whitby, the coast and the villages between:
  </Areas>

  <!-- 8. FIND US -->
  <Section bg="white">
    <div class="find">
      <div class="find__map reveal">
        <!-- Placeholder until the consent layer lands and a real Maps embed can
             load (build standard §6/§7). Caption reworded 30 July 2026: it was
             the one em dash in visible copy anywhere on the site. -->
        <PhotoSlot ratio="4 / 3" radius="xl" caption="Map of 20 Skinner Street, Whitby YO21 3AJ" />
      </div>
      <div class="find__copy reveal">
        <Eyebrow>Come and find us</Eyebrow>
        <h2 class="h2">Find us on Skinner Street</h2>
        <p class="find__lead">
          Abbey Group, 20 Skinner Street, Whitby, North Yorkshire, YO21 3AJ. We are a local
          business with a real office, so you can pop in, have a proper conversation and meet
          the team.
        </p>
        <ul class="find__list">
          <li><Icon name="map-pin" size={17} /><span>{nap.addressFull}</span></li>
          <li><Icon name="clock" size={17} /><span>{nap.hours}</span></li>
          <li>
            <Icon name="phone" size={17} />
            <span>
              <a class="tnum" href={`tel:${nap.phone.tel}`}>{nap.phone.label}</a>
              <span class="find__sep">·</span>
              <a class="tnum" href={`tel:${nap.mobile.tel}`}>{nap.mobile.label}</a>
            </span>
          </li>
        </ul>
      </div>
    </div>
  </Section>

  <!-- 8. FAQ -->
  <FAQ heading="Questions people ask" items={faqs} bg="sunken" />

  <!-- 9. FINAL CTA -->
  <Section bg="white" borderTop>
    <div class="final reveal">
      <h2 class="h2">Not sure who you need? Start with us</h2>
      <p class="final__body">
        Tell us what is going on, and we will tell you honestly what it needs, who will do
        it, and what it will cost. No obligation.
      </p>
      <Button href={booking.quote} external size="lg">Get a Quote</Button>
      <p class="final__phone">
        Or call the Whitby office on <a class="tnum" href={`tel:${nap.phone.tel}`}>{nap.phone.label}</a>.
      </p>
    </div>
  </Section>
</BaseLayout>

<style>
  /* Shared H2 */
  .h2 {
    font-size: clamp(32px, 3.2vw, 46px);
    color: var(--text-heading);
    margin-top: 10px;
  }

  /* ---------- 1. HERO ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    color: var(--white);
    /* The lead's measure, declared here because the VAN's position is derived
       from it (see .hero__van). Change this one value and the van keeps clear
       automatically. Came in from 520px on 30 July 2026 to give the van the room
       Josh asked for; 470px at 18px is a ~56-character line, which is a better
       measure than 62 was anyway. */
    --hero-lead-measure: 470px;
    /* Padding matches PageHero's, so the homepage hero lands on exactly the
       same height as every interior one instead of running ~20px taller. */
    padding: 150px var(--container-padding) 84px;
    min-height: min(92vh, 820px);
    display: flex;
    align-items: center;
    background:
      radial-gradient(1100px 700px at 82% 20%, color-mix(in oklch, var(--blue-800) 55%, transparent) 0%, transparent 60%),
      radial-gradient(800px 600px at 8% 90%, color-mix(in oklch, var(--orange-900) 50%, transparent) 0%, transparent 60%),
      radial-gradient(700px 500px at 45% 0%, color-mix(in oklch, var(--plum-900) 55%, transparent) 0%, transparent 55%),
      var(--ink-500);
  }
  /* Bigger, fainter, no drop shadow. The container carries the scroll drift and
     each of the three arcs moves independently under the pointer — the shared
     hero-mark behaviour from BaseLayout, identical on every page. */
  .hero :global(.hero__crescent) {
    position: absolute;
    left: 46%;
    bottom: -180px;
    z-index: 0;                 /* the van layers over it */
    width: 620px;
    height: auto;
    opacity: 0.11;
    pointer-events: none;
    transform: translate3d(0, var(--mark-scroll, 0px), 0);
    will-change: transform;
  }

  .hero__grid {
    position: relative;
    z-index: 2;
    max-width: calc(var(--container-max) + 2 * var(--container-padding));
  }
  .hero__copy { display: flex; flex-direction: column; align-items: flex-start; gap: 26px; max-width: 620px; }
  .hero__eyebrow {
    margin: 0;
    font-size: 13px;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-muted-inverse);
  }
  .hero__h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(44px, 4.8vw, 72px);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
    color: var(--white);
  }
  .hero__lead {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--text-body-inverse);
    max-width: var(--hero-lead-measure);
  }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 14px; }

  /* --- Van --- */
  .hero__van {
    position: absolute;
    /* Larger and further off the edge (Josh, 29 July 2026). The van is scaled up
       (438px tall against the old 326px) and pushed well past the right edge, so
       it reads bigger and already leaving the frame. The offset is what keeps its
       left edge clear of the copy column: scaling up without it put the rear of
       the van over the lead paragraph and the CTA. The hero clips it, so it still
       cannot cause horizontal overflow.

       Pulled back in and dropped to the floor (Josh, 30 July 2026). The asset is
       tightly cropped (opaque pixels run x 2-1300 of 1302 and y 1-473 of 475,
       measured off the file), so `bottom: 0` puts the tyre contact patches
       exactly on the hero's bottom edge: 0.9px of gap, nothing to fake.

       Horizontally it is now the smaller of two rules, because -340px alone
       drives the van's rear into the hero lead, and the pixels it would sit
       behind are the bright crescent on the van's own rear panel: sampled at
       1.18-2.72:1 against white text, so a few words of the lead would be
       unreadable. The max() keeps the van's left edge one notch clear of the
       lead's measure whatever the viewport does. That also fixes a collision
       that ALREADY existed between 1024px and 1400px with the old -450px, where
       the van reached ~100px into the paragraph. */
    --van-w: min(1180px, 88vw);
    left: max(
      calc(2 * var(--container-padding) + var(--hero-lead-measure) + 8px),
      calc(100% + 340px - var(--van-w))
    );
    right: auto;
    bottom: 0;
    z-index: 1;
    width: var(--van-w);
    pointer-events: none;
    /* JS sets --van-x as you scroll; transform only, so it stays cheap. */
    transform: translate3d(var(--van-x, 0px), 0, 0);
    will-change: transform;
  }
  .hero__van img { width: 100%; height: auto; display: block; }
  .hero__reassure { font-size: var(--text-sm); color: var(--text-muted-inverse); }
  .hero__reassure a { color: var(--blue-300); font-weight: var(--weight-semibold); }
  .hero__reassure a:hover { color: var(--blue-200); }

  @media (prefers-reduced-motion: reduce) {
    .hero :global(.hero__crescent), .hero__van { transform: none; will-change: auto; }
  }

  /* ---------- 2. TRUST STRIP ---------- */
  .trust {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .trust li {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-align: left;
  }
  .trust :global(svg) { color: var(--blue-500); flex: none; }
  .trust span { font-size: 14.5px; font-weight: var(--weight-semibold); color: var(--text-heading); }

  /* ---------- 3. DIVISIONS ---------- */
  .dv__head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: end;
    margin-bottom: 48px;
  }
  .dv__intro { font-size: var(--text-base); line-height: var(--leading-relaxed); color: var(--text-body); }

  .dv__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .dv__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--white);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: transform var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out);
  }
  .dv__card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }

  /* Division colour tab across the top of each card */
  .dv__bar {
    display: block;
    height: 5px;
    background: var(--accent);
    transition: height var(--duration-base) var(--ease-out);
  }
  .dv__card:hover .dv__bar { height: 8px; }

  /* `:global()` from a scoped ancestor, because `.dv__photo` is passed INTO
     Photo/DivisionSlot and so carries THEIR scope id, not this page's. Written
     as a plain `.dv__photo` rule it matched nothing and the hairline between
     photo and card body was silently missing (rule 19's gotcha, measured
     30 July 2026: computed border-bottom-width was 0px). */
  .dv__card :global(.dv__photo) { border-bottom: 1px solid var(--border-subtle); }
  /* Body carries a whisper of the division colour so the card is tinted, not
     just badged. Kept very low so body copy contrast is unaffected. */
  .dv__body {
    display: flex; flex-direction: column; gap: 10px;
    padding: 22px 24px 24px; flex: 1;
    background: color-mix(in oklch, var(--accent) 4%, var(--white));
  }
  .dv__titlerow { display: flex; align-items: center; gap: 12px; }
  .dv__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: var(--radius-signature);
    background: color-mix(in oklch, var(--accent) 14%, var(--white));
    color: var(--accent-ink);
  }
  .dv__title { font-family: var(--font-display); font-size: 21px; color: var(--text-heading); }
  .dv__desc { font-size: 14.5px; line-height: var(--leading-normal); color: var(--text-body); flex: 1; }
  .dv__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: var(--weight-bold);
    color: var(--accent-ink);
  }

  /* Sixth tile — navy, so it reads as the catch-all rather than a service */
  .dv__card--group {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(520px 380px at 88% 12%, color-mix(in oklch, var(--blue-800) 45%, transparent) 0%, transparent 65%),
      var(--ink-500);
    border-color: transparent;
    justify-content: center;
  }
  .dv__groupmark {
    position: absolute;
    right: -60px;
    bottom: -70px;
    width: 260px;
    opacity: 0.16;
    pointer-events: none;
  }
  .dv__groupbody {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 30px 26px;
  }
  .dv__grouptitle { font-family: var(--font-display); font-size: 24px; color: var(--white); }
  .dv__groupdesc { font-size: 14.5px; line-height: var(--leading-relaxed); color: var(--text-body-inverse); }
  .dv__grouplink {
    display: inline-flex; align-items: center; gap: 8px;
    margin-top: 2px;
    font-size: 15px; font-weight: var(--weight-bold);
    color: var(--white);
  }
  .dv__grouplink :global(svg) { color: var(--blue-300); flex: none; }
  .dv__card--group:hover .dv__grouplink { color: var(--blue-200); }

  @media (prefers-reduced-motion: reduce) {
    .dv__card, .dv__bar { transition: none; }
    .dv__card:hover { transform: none; }
    .dv__card:hover .dv__bar { height: 5px; }
  }

  /* ---------- 4. WHY PEOPLE STAY ---------- */
  .way { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 64px; align-items: center; }
  .way__left { display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }
  .way__intro { font-size: var(--text-base); color: var(--text-body); line-height: var(--leading-relaxed); }
  .way__quote {
    margin: 8px 0 0;
    padding: 24px 28px;
    border-radius: var(--radius-lg);
    background: var(--ink-500);
    color: var(--white);
    box-shadow: var(--shadow-md);
    font-family: var(--font-display);
    font-size: 20px;
    line-height: var(--leading-snug);
  }
  .way__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .way__card {
    display: flex;
    flex-direction: column;
    gap: 14px;
