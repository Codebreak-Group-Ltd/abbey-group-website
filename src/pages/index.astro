    .way__grid { grid-template-columns: 1fr; }
    .trust { grid-template-columns: 1fr; }
    .trust li { justify-content: flex-start; }
    .hero :global(.hero__crescent) { width: 420px; left: 26%; bottom: -120px; }
  }
</style>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Van drives off to the right as the hero scrolls away.
     Scroll progress across the hero maps to a translateX, written to a custom
     property so the compositor does the work. Skipped under reduced motion,
     where the van simply sits still.

     Smoothed and slowed (Josh, 29 July 2026): the raw mapping felt fast, partly
     because scaling the van up had also scaled its travel distance. Two changes
     — the distance is now a fraction of the viewport rather than the van's own
     width, and the position eases toward its scroll target each frame instead
     of jumping straight to it, so it glides with the scroll rather than
     tracking it exactly. */
  const van = document.querySelector<HTMLElement>('[data-van]');
  const heroEl = document.querySelector<HTMLElement>('.hero');
  if (!prefersReduced && van && heroEl) {
    let target = 0, current = 0, easing = false;

    const measure = () => {
      const heroBottom = heroEl.offsetTop + heroEl.offsetHeight;
      const progress = Math.min(Math.max(window.scrollY / Math.max(heroBottom, 1), 0), 1);
      target = progress * window.innerWidth * 0.42;
      if (!easing) { easing = true; window.requestAnimationFrame(ease); }
    };

    const ease = () => {
      current += (target - current) * 0.075;
      van.style.setProperty('--van-x', `${current.toFixed(2)}px`);
      if (Math.abs(target - current) > 0.2) {
        window.requestAnimationFrame(ease);
      } else {
        easing = false;
      }
    };

    measure();
    window.addEventListener('scroll', measure, { passive: true });
    window.addEventListener('resize', measure, { passive: true });
  }
  /* The hero watermark's pointer parallax and scroll drift live in BaseLayout,
     shared with every other hero on the site. */
</script>
