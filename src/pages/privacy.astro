---
import LegalLayout from '../layouts/LegalLayout.astro';
import { site, nap, routes } from '../data/site.ts';
import { processors, retention, vatNumber } from '../data/legal.ts';
import { consentRegistry } from '../data/consent-registry.ts';

/* Privacy policy — describes what this build ACTUALLY does, not a template.
   Processors and retention periods come from `src/data/legal.ts` (confirmed by
   Josh, 30 July 2026); the cookie position comes from the consent registry,
   which is empty, so the page says so plainly.
   Draft for Abbey Group and their solicitor to review before go-live. */

const title = 'Privacy Policy | Abbey Group Whitby';
const description =
  'How Abbey Group in Whitby collects, uses and protects your personal information when you contact us, book a visit or join a Homecare Plan.';

const tracking = consentRegistry.length > 0;
---
<LegalLayout
  title={title}
  description={description}
  heading="Privacy Policy"
  path={routes.privacy}
  intro="How we collect and use your personal information when you contact us, request a quote, book a visit, or join one of our Homecare Plans."
>
  <h2>Who we are</h2>
  <p>
    {site.legalName}, trading as {site.tradingAs}, is the data controller for the
    information described in this policy. We are registered in {site.registeredIn},
    company number {site.companyNo}, and our registered office is {nap.addressFull}.
  </p>
  {vatNumber && <p>Our VAT registration number is {vatNumber}.</p>}
  {!vatNumber && (
    <span class="legal-gap">
      <strong>To add before publication:</strong> the VAT registration number. Abbey
      Group quote prices excluding VAT, so the number belongs here and in the footer.
    </span>
  )}
  <p>
    You can contact us about anything in this policy by emailing
    <a href={`mailto:${nap.email}`}>{nap.email}</a> or calling
    <a href={`tel:${nap.phone.tel}`}>{nap.phone.label}</a>.
  </p>

  <h2>What we collect</h2>
  <p>We only ask for what we need to help you, and we tell you why at the point we ask.</p>
  <ul>
    <li>
      <strong>When you send an enquiry or ask for a quote:</strong> your name, phone
      number, email address, postcode, and whatever you tell us about the job.
    </li>
    <li>
      <strong>When you book online:</strong> the same details, plus the job type and
      appointment, taken through our booking system.
    </li>
    <li>
      <strong>When you join a Homecare Plan:</strong> your name, address, contact
      details, payment details, and information about your boiler and heating system,
      so we can run the Plan.
    </li>
    <li>
      <strong>When you visit the site:</strong> standard technical information kept by
      our hosting provider, such as your IP address, which is needed to deliver the
      site and keep it secure.
    </li>
  </ul>
  <p>
    If you arrive from an advert, the enquiry you send may include the advert reference
    from the web address you arrived on, so we know which advert brought you to us.
    That is read at the moment you submit the form and is not stored on your device.
  </p>

  <h2>Why we use it, and our lawful basis</h2>
  <table>
    <thead>
      <tr><th>What we use it for</th><th>Lawful basis</th></tr>
    </thead>
    <tbody>
      <tr>
        <td>Answering your enquiry and preparing a quote</td>
        <td>Steps taken at your request before entering a contract</td>
      </tr>
      <tr>
        <td>Booking and carrying out work, and running your Homecare Plan</td>
        <td>Performance of our contract with you</td>
      </tr>
      <tr>
        <td>Keeping gas and electrical safety records, and our accounts</td>
        <td>Legal obligation</td>
      </tr>
      <tr>
        <td>Keeping the website working and secure</td>
        <td>Our legitimate interest in running the site</td>
      </tr>
    </tbody>
  </table>

  <h2>Who we share it with</h2>
  <p>
    We share your information with the companies that help us run the business, and
    with nobody else. We do not sell your information.
  </p>
  <ul>
    {processors.map((p) => (
      <li>
        <strong>{p.name}{p.companyNo ? ` (company no. ${p.companyNo})` : ''}.</strong>{' '}
        {p.purpose}{p.plansOnly ? ' This applies only if you hold a Homecare Plan.' : ''}
      </li>
    ))}
  </ul>
  <p>
    Some of these providers may process data outside the UK. Where they do, appropriate
    safeguards such as Standard Contractual Clauses are in place so your information
    stays protected.
  </p>
  {!tracking && (
    <p>
      We do not currently use any analytics or advertising services on this website. If
      that changes, this policy and our <a href={routes.cookies}>Cookie Policy</a> will be
      updated at the same time, and nothing of that kind will load without your consent.
    </p>
  )}

  <h2>How long we keep it</h2>
  <table>
    <thead>
      <tr><th>What</th><th>How long</th><th>Why</th></tr>
    </thead>
    <tbody>
      {retention.map((r) => (
        <tr><td>{r.what}</td><td>{r.period}</td><td>{r.why}</td></tr>
      ))}
    </tbody>
  </table>
  <p>We do not keep personal information for longer than we need it.</p>

  <h2>Your rights</h2>
  <p>Under UK data protection law you have the right to:</p>
  <ul>
    <li>ask for a copy of the personal information we hold about you</li>
    <li>ask us to correct anything that is wrong</li>
    <li>ask us to delete information we are not required to keep</li>
    <li>object to, or ask us to restrict, how we use it</li>
    <li>ask for your information in a portable format</li>
    <li>withdraw your consent at any time, where we rely on consent</li>
  </ul>
  <p>
    To use any of these, email <a href={`mailto:${nap.email}`}>{nap.email}</a>. If you are
    unhappy with how we have handled your information you can complain to the
    Information Commissioner's Office at
    <a href="https://ico.org.uk" target="_blank" rel="noopener noreferrer">ico.org.uk</a>.
  </p>

  <h2>Cookies</h2>
  <p>
    See our <a href={routes.cookies}>Cookie Policy</a> for what this site stores on your
    device. At the moment, that is nothing.
  </p>

  <h2>Changes to this policy</h2>
  <p>
    We may update this policy from time to time. The date at the top shows when it last
    changed.
  </p>
</LegalLayout>
