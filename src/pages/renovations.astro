---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';
import Reviews from '../components/Reviews.astro';
import FAQ from '../components/FAQ.astro';
import Areas from '../components/Areas.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Photo from '../components/Photo.astro';
import { nap, booking, routes, renovationsReviews } from '../data/site.ts';
import { renovationsFaqs } from '../data/faqs.ts';
import { service, faqPage, breadcrumb } from '../lib/schema.ts';
import { divisions } from '../data/divisions.ts';

/* Renovations — the flagship, most expensive service (£300k+ projects), so this
   page has to look worth it before a word is read. Plum-anchored like Building &
   Joinery (same team) but deliberately built to a different set of rules, so the
   two cannot be mistaken for each other. Keeps the Abbey GROUP lockup in the
   header by design (divisions.renovations.hasLockup === false).
   Copy: `04 Renovations/Text/Renovations - COPY.md`.

   REBUILT 30 July 2026 (Josh: "it doesn't scream world class"). What changed and
   why, since every decision here is a deliberate departure from the trade-page
   pattern rather than a restyle:

   1. RESTRAINT IS THE SIGNAL. The reliable markers of an expensive page are
      whitespace, few type sizes and ONE strong visual per section, not more
      decoration. So: `pad="loose"` (136px bands rather than 96px), a larger
      display scale, hairlines instead of cards, and the photography count on
      "Our work" went DOWN from five images to six doing far more work each.
   2. THE "WHAT WE DO" GRID IS GONE. Five hairline cells with small numerals
      read as a spec sheet. It is now an editorial index: a tall photograph
      beside five full-width rows, each with an oversized numeral and the
      service set at 30px in the display face. Nothing on any other page looks
      like it.
   3. PROJECTS ARE CASE STUDIES, NOT A THUMBNAIL GRID. High-value buyers are
      vetting craft and want to see a whole job. Two named blocks, each a large
      lead photograph plus two supporting ones and the actual scope, rather than
      one feature shot and a row of 4:3 thumbs with one-word captions.
   4. THE SECOND PROJECT SET IS FINALLY ON THE PAGE. Thirteen photographs of a
      clearly high-end whole-house job were sitting unused in
      `Images/Unconfirmed Project (ask Amy which one)/`. The black kitchen with
      the book-matched quartz island is now the hero (it also proves the Sparkle
      Granite worktop claim), and the marble bathroom, brass basin detail and
      stone-and-oak dining room carry the second case study. Captioned "Recent
      project" until Amy confirms WHICH project, exactly as Building & Joinery
      already does.
   5. HOW IT DIFFERS FROM BUILDING & JOINERY, concretely: no ticked service
      list, no chip icons, no card shadows, no tick discs; hairline rules,
      oversized numerals, warm stone surfaces, 136px bands, a masthead-style
      credential line instead of four green ticks, and a verified review set as
      a display pull quote. Joinery keeps all the trade-page furniture. */

const title = 'Home Renovations Whitby | Kitchens, Bathrooms & Extensions';
const description =
  'Bespoke kitchen, bathroom and home renovations in Whitby, project-managed by one local team using premium, locally sourced materials. Abbey Group.';

const services = [
  {
    t: 'Kitchens',
    d: 'Bespoke kitchens designed around how you actually live, fitted to a standard that lasts.',
  },
  {
    t: 'Bathrooms',
    d: 'From family bathrooms to en-suites and wet rooms, tiled and finished with care.',
  },
  {
    t: 'Extensions',
    d: 'Single and multi-storey extensions that add real space and value, built to last.',
  },
  {
    t: 'Whole-house renovations',
    d: 'Bigger projects taken on end to end, with everything coordinated by one team.',
  },
  {
    t: 'Worktops and finishes',
    d: 'Quartz and granite worktops, templated and fitted, and the details that make a room feel finished.',
  },
];

const promises = [
  'One point of contact who knows your project inside out.',
  'Trades that arrive in the right order, so the job keeps moving.',
  'Fresh plastic sheeting down every Monday, and your house handed back clean every Friday.',
  'We hire and manage the skip, so it is one less thing on your plate.',
  'A price and a programme agreed up front, and a team who work to them.',
];

/* Two case studies. Riviera is the named project Amy has confirmed. The second
   is the whole-house job whose photographs arrived in
   `Images/Unconfirmed Project (ask Amy which one)/`: it is plainly one of
   Linfitt, Customs House, Argyle Road, Morrisons or Danby Castle, but until Amy
   says which, it is captioned "Recent project" with no name and no place beyond
   North Yorkshire. That is the same treatment Building & Joinery already uses.
   Every scope item below is visible in the photographs of that project. */
const projects = [
  {
    name: 'Riviera',
    place: 'Whitby',
    summary:
      'A whole-property refurbishment run as one project, from the open-plan kitchen and living space through to the bathrooms and the fitted joinery.',
    scope: ['Kitchen and open-plan living', 'Bathrooms and en-suites', 'Bespoke joinery', 'Finishes throughout'],
    lead: {
      src: '/images/renovations-riviera-open-plan-living.webp',
      alt: 'Open-plan kitchen and living space with a sea view in the Riviera renovation in Whitby by Abbey Group',
    },
    more: [
      {
        src: '/images/renovations-riviera-ensuite-marble.webp',
        alt: 'Marble en-suite bathroom with brushed gold fittings in the Riviera renovation in Whitby by Abbey Group',
        label: 'Marble en-suite',
      },
      {
        src: '/images/renovations-riviera-living-room-fireplace.webp',
        alt: 'Living room with stone fireplace and bespoke alcove shelving in the Riviera renovation in Whitby by Abbey Group',
        label: 'Living room and alcove joinery',
      },
    ],
  },
  {
    name: 'Recent project',
    place: 'North Yorkshire',
    summary:
      'A whole-house renovation where the original stone was kept and worked into the finish: black handleless kitchen with a book-matched quartz island, marble bathrooms, and a dining room around the log burner.',
    scope: ['Kitchen and quartz worktops', 'Two bathrooms', 'Dining and living space', 'Original stone retained'],
    lead: {
      src: '/images/renovations-project-dining-stone.webp',
      alt: 'Dining space with exposed stone, an oak beam mantel and a log burner, renovated by Abbey Group',
    },
    more: [
      {
        src: '/images/renovations-project-marble-bathroom.webp',
        alt: 'Bathroom with pink onyx marble walls, a freestanding bath and brushed brass fittings by Abbey Group',
        label: 'Onyx marble bathroom',
      },
      {
        src: '/images/renovations-project-brass-basin.webp',
        alt: 'Stone-tiled bathroom with a brass basin tap, brass tile trims and a round mirror by Abbey Group',
        label: 'Brass trims and fittings',
      },
    ],
  },
  /* Esplanade landed 3 August 2026 (see image-manifest.md). Named from the
     photography folder itself, per Josh's confirmation that the newly
     landed sets are nameable; place is left off until Amy confirms the
     exact address, same treatment as "Recent project" above. */
  {
    name: 'Esplanade',
    place: 'North Yorkshire',
    summary:
      'A full flat renovation: a feature fireplace wall in the living room, a bedroom fitted with sliding wardrobes, and a fully retiled bathroom.',
    scope: ['Living room and feature fireplace wall', 'Bedroom with fitted sliding wardrobes', 'Bathroom renovation', 'Decorating throughout'],
    lead: {
      src: '/images/renovations-esplanade-bedroom-wardrobes.webp',
      alt: 'Bedroom with fitted sliding oak wardrobes and a navy feature wall, renovated by Abbey Group',
    },
    more: [
      {
        src: '/images/renovations-esplanade-fireplace-wall.webp',
        alt: 'Living room feature wall with an inset electric fire, renovated by Abbey Group',
        label: 'Feature fireplace wall',
      },
      {
        src: '/images/renovations-esplanade-bathroom-tiled.webp',
        alt: 'Fully tiled bathroom with a glass shower screen, renovated by Abbey Group',
        label: 'Retiled bathroom',
      },
    ],
  },
];

/* The client-approved FAQ set for this page. It lives in `src/data/faqs.ts`
   because the page, its FAQPage JSON-LD and `/llms.txt` all read the same
   text and must never disagree. */
const faqs = renovationsFaqs;

const schemas = [
  service({
    name: 'Home Renovations',
    path: routes.renovations,
    serviceType: 'Home renovation, kitchens, bathrooms and extensions',
    description,
  }),
  faqPage(faqs),
  breadcrumb([
    { name: 'Home', path: routes.home },
    { name: 'Renovations', path: routes.renovations },
  ]),
];
---
<BaseLayout title={title} description={description} schemas={schemas} division="renovations">
  <!-- The H1 carries a non-breaking space after the ampersand, so a line can
       never end on "&". -->
  <!-- The division marker is ON here now. It is set type rather than brand art,
       so a service-level division can carry one without inventing a lockup, and
       it reads simply "Renovations" (no "Abbey" prefix, because Abbey Renovations
       is not a sub-brand the client has). -->
  <PageHero
    division="renovations"
    media="feature"
    mediaRadius="none"
    trustStyle="rule"
    title={'Bespoke Home Renovations in Whitby & North Yorkshire'}
    lead="Kitchens, bathrooms and extensions, project-managed start to finish by one local team who leave your house better than they found it. From the first drawing to the final clean, you have one number to call and one team who own the result."
    trust={['One point of contact', 'Local', 'Materials sourced locally', 'Rated 4.6 on Google']}
    image="/images/renovations-hero-kitchen-island.webp"
    imageAlt="Bespoke kitchen with black handleless units and a book-matched quartz island, renovated by Abbey Group"
  >
    <Button href={booking.quote} external size="lg">Arrange a Consultation</Button>
    <Button href="#our-work" variant="inverse-outline" size="lg">See Our Work</Button>
  </PageHero>

  <!-- WHAT WE DO — the editorial index. Replaces a 3x2 grid of hairline cells
       that read as a spec sheet. A tall photograph holds the left, and each
       service is a full-width row: oversized numeral, the name at 30px in the
       display face, one line of description. Nothing else on the site is set
       like this, which is the point. -->
  <Section bg="white" pad="loose">
    <div class="scope">
      <div class="scope__head reveal">
        <Eyebrow>What we do</Eyebrow>
        <h2 class="rh2">Renovations done properly, start to finish</h2>
        <p class="rlead">
          Whether it is one room or the whole house, we design it, build it and finish it
          as a single project.
        </p>
      </div>

      <figure class="scope__media reveal">
        <Photo
          src="/images/renovations-stone-bathroom-brass.webp"
          alt="Exposed stone wall, brushed brass tap and a backlit round mirror in a bathroom renovated by Abbey Group"
          ratio="3 / 4"
          radius="none"
          bordered={false}
          width={920}
          height={1227}
        />
        <figcaption class="scope__cap">
          Original Yorkshire stone kept and lit, with brushed brass throughout. Recent
          project.
        </figcaption>
      </figure>

      <ol class="scope__list reveal">
        {services.map((s, i) => (
          <li class="scope__row">
            <span class="scope__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="scope__body">
              <h3 class="scope__t">{s.t}</h3>
              <p class="scope__d">{s.d}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="scope__cta reveal">
        <Button href={booking.quote} external size="lg">Arrange a Consultation</Button>
      </div>
    </div>
  </Section>

  <!-- HOW WE WORK -->
  <Section bg="dark" bleed>
    <div class="hww">
      <img class="hww__mark" src={divisions.renovations.mark} alt="" aria-hidden="true" width="380" height="399" />
      <div class="container hww__inner reveal">
        <div class="hww__copy">
          <Eyebrow tone="inverse">How we work</Eyebrow>
          <h2 class="hww__h2">One team, managed from first drawing to final clean</h2>
          <p class="hww__lead">
            A renovation goes wrong when nobody owns it. With us, one team manages the
            whole job, so you are not left coordinating a builder, a plumber, an
            electrician and a joiner yourself.
          </p>
          <!-- Numbered rather than ticked. Building & Joinery owns the ticked
               service list; if this page used one too the two would read as the
               same template in two colours. -->
          <ol class="hww__list">
            {promises.map((p, i) => (
              <li>
                <span class="hww__step" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span>{p}</span>
              </li>
            ))}
          </ol>

          <!-- A verified review, set as a display pull quote, placed in the
               section it actually speaks to. Colin's review is about James
               running a multi-trade job; quoted verbatim from the reviews
               master, exclamation marks and capitals included (convention 8). -->
          <figure class="hww__quote">
            <blockquote>What an AMAZING company Abbeygas of Whitby are, all the way from the owner, James.</blockquote>
            <figcaption>Colin Robertson<span aria-hidden="true"> · </span><span class="hww__quotesrc">Google review</span></figcaption>
          </figure>
        </div>

        <div class="hww__side">
          <!-- The 12-month check-back is the page's strongest care point, so it
               gets feature treatment inside this section rather than a section
               of its own (copy conventions §7). -->
          <div class="hww__card">
            <p class="hww__cardnum tnum" aria-hidden="true">12</p>
            <h3 class="hww__cardt">And we come back a year later</h3>
            <p class="hww__cardd">
              Twelve months after we fit a kitchen, we return and check it over,
              realigning any doors and drawers that have settled with use. Nobody asks
              us to. We do it because a kitchen should still feel right a year on, not
              just on handover day.
            </p>
          </div>
          <Photo
            src="/images/renovations-lounge-sea-view.webp"
            alt="Renovated sitting room with a sea view in Whitby by Abbey Group"
            ratio="16 / 9"
            radius="lg"
            width={1100}
            height={619}
            class="hww__photo"
          />
        </div>
      </div>
    </div>
  </Section>

  <!-- WHO WE WORK WITH -->
  <Section bg="sunken" pad="loose">
    <div class="sup reveal">
      <div class="sup__copy">
        <Eyebrow>Who we work with</Eyebrow>
        <h2 class="rh2">Quality materials, much of it sourced locally</h2>
        <p class="rlead">
          On a renovation, the materials matter as much as the labour. We buy from people
          we know and trust, and a lot of it is local. That means you get exceptional,
          high-quality work rather than generic materials marked up.
        </p>

        <div class="sup__panels">
          <div class="sup__panel">
            <h3 class="sup__panelt">Local first</h3>
            <p>
              Worktops come from <strong>Sparkle Granite</strong> in Guisborough,
              templated, made and fitted to measure. Building materials come from
              <strong>MKM</strong> in Whitby, and flooring from
              <strong>Fletcher &amp; Woodhouse</strong>, trusted local flooring experts of
              over 20 years.
            </p>
          </div>
          <div class="sup__panel">
            <h3 class="sup__panelt">Recognised brands</h3>
            <p>
              For heating and hot water we fit names people trust, including
              <strong>Worcester Bosch</strong> and <strong>Ideal</strong>, with
              <strong>Nu-Heat</strong> and <strong>UK Underfloor</strong> for underfloor
              heating, and <strong>Calor</strong> for off-grid LPG.
            </p>
          </div>
        </div>

        <p class="sup__note">Money stays local, and the quality comes from suppliers we have worked with for years.</p>
      </div>

      <aside class="sup__media">
        <Photo
          src="/images/renovations-suppliers-materials.webp"
          alt="Premium, locally sourced materials used by Abbey Group renovations"
          ratio="4 / 5"
          radius="lg"
          bordered={false}
          width={900}
          height={1125}
        />
      </aside>
    </div>
  </Section>

  <!-- OUR WORK — two case studies rather than a feature shot plus a row of 4:3
       thumbs. Each block is a large lead photograph, the project's own name, the
       actual scope as hairline-separated items, and two supporting shots. This is
       the highest-leverage content on the page (page brief §6): a £300k buyer
       wants to see a whole job, not a contact sheet. -->
  <Section bg="white" id="our-work" pad="loose">
    <div class="work__head reveal">
      <Eyebrow>Our work</Eyebrow>
      <h2 class="rh2">Recent projects</h2>
      <p class="rlead">
        Recent projects across Whitby and North Yorkshire include Riviera, Esplanade,
        Linfitt, Customs House, Argyle Road, our Morrisons project with a loft
        conversion, and Danby Castle. Three are shown here, with more to follow as
        the photography comes in.
      </p>
    </div>

    {projects.map((p) => (
      <article class="cs reveal">
        <figure class="cs__lead">
          <Photo
            src={p.lead.src}
            alt={p.lead.alt}
            ratio="3 / 2"
            radius="none"
            bordered={false}
            width={1700}
            height={1133}
          />
        </figure>

        <div class="cs__meta">
          <h3 class="cs__name">{p.name}</h3>
          <p class="cs__place">{p.place}</p>
          <p class="cs__summary">{p.summary}</p>
          <ul class="cs__scope">
            {p.scope.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <ul class="cs__more">
          {p.more.map((m) => (
            <li>
              <Photo src={m.src} alt={m.alt} ratio="3 / 2" radius="none" bordered={false} width={1200} height={800} />
              <p class="cs__morecap">{m.label}</p>
            </li>
          ))}
        </ul>
      </article>
    ))}

    <div class="work__cta reveal">
      <Button href={booking.quote} external size="lg">Arrange a Consultation</Button>
      <p class="work__ctanote">
        We can walk you through recent projects in person, including the ones whose
        photographs are still on their way.
      </p>
    </div>
  </Section>

  <!-- REVIEWS -->
  <Reviews
    eyebrow="What our clients say"
    heading="Bigger jobs, run properly"
    reviews={renovationsReviews}
    bg="sunken"
  />

  <!-- AREAS -->
  <Areas heading="Renovations across Whitby and North Yorkshire" bg="white" division="renovations">
    These are the places we work most often:
  </Areas>

  <!-- FAQ -->
  <FAQ heading="Renovation questions, answered" items={faqs} bg="sunken" />

  <!-- SAME TEAM, OTHER TRADES -->
  <Section bg="dark" bleed>
    <div class="xl">
      <div class="container xl__inner reveal">
        <div class="xl__copy">
          <Eyebrow tone="inverse">Part of the same project</Eyebrow>
          <h2 class="xl__h2">Joinery and electrical work, in house</h2>
        </div>
        <ul class="xl__cards">
          <li>
            <h3><a href={routes.joinery}>Building &amp; Joinery</a></h3>
            <p>Made-to-measure joinery and structural work, from staircases and fitted furniture to the building side of a project.</p>
          </li>
          <li>
            <h3><a href={routes.electrical}>Electrical</a></h3>
            <p>Rewiring, lighting and certification as part of a renovation, so the electrical work is not a separate contractor to chase.</p>
          </li>
        </ul>
      </div>
    </div>
  </Section>

  <!-- ENQUIRY -->
  <EnquiryForm
    heading="Arrange a consultation"
    lead="Tell us about your project and we will arrange a consultation, talk through what you want, and give you an honest quote. There is no obligation, and every figure is based on your actual project rather than a guess."
    source="Renovations"
    tags="renovations,consultation"
    submitLabel="Arrange a Consultation"
    bg="sunken"
    fields={[
      { name: 'name', label: 'Name', required: true, autocomplete: 'name' },
      { name: 'phone', label: 'Phone', type: 'tel', required: true, autocomplete: 'tel' },
      { name: 'email', label: 'Email', type: 'email', autocomplete: 'email' },
      { name: 'postcode', label: 'Postcode', autocomplete: 'postal-code' },
      { name: 'message', label: 'About your project', type: 'textarea', full: true },
    ]}
  >
    <div class="rn-formside">
      <Button href={`tel:${nap.phone.tel}`} variant="outline" size="lg">Call the Whitby office</Button>
      <p class="rn-formside__note">
        The office is open {nap.hours}, and the line takes messages outside those hours.
      </p>
    </div>
  </EnquiryForm>
</BaseLayout>

<style>
  /* Editorial type scale for this page: a step larger than the trade pages,
     with a wider measure and more air, because Renovations is the premium
     service and has to look it. */
  .rh2 {
    font-size: clamp(34px, 3.6vw, 52px);
    color: var(--text-heading);
    margin-top: 12px;
  }
  .rlead {
    margin-top: 20px;
    max-width: 62ch;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--text-body);
  }

  /* WHAT WE DO — the editorial index ------------------------------------- */
  /* Two columns: a tall photograph on the left, the scope as full-width rows on
     the right. The heading spans, so the photograph and the first row start on
     the same line. */
  .scope {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    column-gap: 72px;
  }
  .scope__head { grid-column: 1 / -1; max-width: 760px; margin-bottom: 64px; }
  .scope__media { grid-column: 1; grid-row: 2; margin: 0; align-self: start; }
  .scope__media :global(.photo) { box-shadow: none; }
  .scope__cap {
    margin-top: 16px;
    font-size: 13.5px;
    line-height: var(--leading-relaxed);
    color: var(--stone-700);
    max-width: 34ch;
  }
  .scope__list { grid-column: 2; grid-row: 2; border-top: 1px solid var(--stone-200); }
  .scope__row {
    display: grid;
    grid-template-columns: 92px 1fr;
    align-items: baseline;
    gap: 0 8px;
    padding-block: 30px;
    border-bottom: 1px solid var(--stone-200);
  }
  /* Oversized numeral in stone: it sets the rhythm and is the page's one
     decorative flourish. Not a coloured chip, and not an icon. */
  .scope__num {
    font-family: var(--font-display);
    font-size: 40px;
    line-height: 1;
    color: var(--stone-300);
    font-variant-numeric: tabular-nums;
  }
  .scope__t {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(26px, 2.1vw, 31px);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--text-heading);
  }
  .scope__d {
    margin-top: 10px;
    font-size: 16px;
    line-height: var(--leading-relaxed);
    color: var(--text-body);
    max-width: 52ch;
  }
  .scope__cta { grid-column: 2; grid-row: 3; margin-top: 48px; }

  /* HOW WE WORK -------------------------------------------------------- */
  .hww {
    position: relative;
    overflow: hidden;
    padding-block: 96px;
    background:
      radial-gradient(900px 620px at 84% 18%, color-mix(in oklch, var(--page-accent-glow) 55%, transparent) 0%, transparent 64%),
      var(--surface-page-dark);
  }
  .hww__mark {
    position: absolute; left: -110px; top: 50%; transform: translateY(-50%);
    width: 380px; opacity: 0.12; pointer-events: none;
  }
  .hww__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    gap: 64px;
    /* Stretch, not start (Josh, 4 August 2026): the copy column's quote runs
       ~140px past the card + fixed-ratio photo, so with `start` the side
       column finished early and left a bare gap of dark ground under the
       photo before the section ended. Stretching the row lets the photo grow
       to fill it — see `.hww__photo` below. */
    align-items: stretch;
  }
  .hww__copy { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .hww__h2 {
    font-family: var(--font-display);
    font-size: clamp(32px, 3.4vw, 50px);
    color: var(--white);
    text-wrap: balance;
  }
  .hww__lead {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--text-body-inverse);
    max-width: 54ch;
  }
  /* Numbered steps on hairlines, not ticks: this is the visible difference
     between this page and Building & Joinery's service list. */
  .hww__list { margin-top: 10px; width: 100%; border-top: 1px solid var(--border-inverse); }
  .hww__list li {
    display: grid;
    grid-template-columns: 54px 1fr;
    align-items: baseline;
    padding-block: 16px;
    border-bottom: 1px solid var(--border-inverse);
    font-size: 15.5px;
    line-height: var(--leading-snug);
    color: var(--text-body-inverse);
  }
  .hww__step {
    font-family: var(--font-display);
