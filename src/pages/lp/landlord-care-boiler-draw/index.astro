<script>
  /* Countdown to the draw close — identical to Variant A and the sibling
     prize-led page. */
  (function () {
    const el = document.querySelector<HTMLElement>('.cd');
    if (!el) return;
    const iso = el.getAttribute('data-deadline');
    if (!iso) return;
    const target = Date.parse(iso);
    if (Number.isNaN(target)) return;

    const timer = el.querySelector<HTMLElement>('.cd__timer');
    const label = el.querySelector<HTMLElement>('.cd__label');
    const dEl = el.querySelector<HTMLElement>('.cd__d');
    const hEl = el.querySelector<HTMLElement>('.cd__h');
    const mEl = el.querySelector<HTMLElement>('.cd__m');
    if (!timer || !label || !dEl || !hEl || !mEl) return;

    function tick() {
      let secs = Math.floor((target - Date.now()) / 1000);
      if (secs <= 0) {
        label.textContent = 'Entries have closed';
        timer.hidden = true;
        return false;
      }
      const days = Math.floor(secs / 86400); secs -= days * 86400;
      const hrs = Math.floor(secs / 3600); secs -= hrs * 3600;
      const mins = Math.floor(secs / 60);
      dEl.textContent = String(days);
      hEl.textContent = String(hrs);
      mEl.textContent = String(mins);
      timer.hidden = false;
      return true;
    }

    if (tick()) {
      const id = setInterval(() => { if (!tick()) clearInterval(id); }, 30000);
    }
  })();
</script>
