---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import Eyebrow from '../../../components/Eyebrow.astro';
import Button from '../../../components/Button.astro';
import Icon from '../../../components/Icon.astro';
import PhotoSlot from '../../../components/PhotoSlot.astro';
import FAQ from '../../../components/FAQ.astro';
import EnquiryForm from '../../../components/EnquiryForm.astro';
import Photo from '../../../components/Photo.astro';
import { nap, site, ratings, homecareReviews, routes } from '../../../data/site.ts';

/* =====================================================================
   /lp/landlord-care-boiler-draw/ — the LANDLORD sibling of Variant A
   (`/lp/service-care-boiler-draw/`). Built 25 Aug 2026 to a brief from
   Josh: same structure, same section order, same components; only the
   copy and figures change, and every figure on this page is the Landlord
   Care one, never Service Care's. Confirmed against `02 PLAN DATA -
   Homecare Plans.md`: £162 service + gas safety certificate, £66 health
   check + filter clean, £114 call-out, £342 total value, £167.88 a year,
   £13.99 a month, £174 saving, £162 as the one-off landlord gas safety
   check figure (same source as the offer stack's first row, so the
   joining-offer section below is internally consistent with it).

   WHAT CARRIES OVER FROM VARIANT A UNCHANGED, because nothing in it names
   a plan or a figure: "who you are dealing with" (§7, per Variant A's own
   "do not touch it"), the free-postal-entry box, the prize draw terms, and
   four of the six FAQs (only "What does £X a month cover?" needed the
   figure swapped; the rest are plan-agnostic).

   PROOF STRIP: no landlord-specific verified review exists anywhere in
   `homecareReviews` (checked before writing this) — the "landlord review"
   idea was raised in `_Specs/01 OUTSTANDING FROM CLIENT.md` as a nice-to-
   have and was never fulfilled. Reused Variant A's Angela quote rather
   than inventing one: a no-heating emergency call-out is exactly what a
   landlord manages for a let property too, so it still lands, but this is
   a deliberate reuse, not an oversight.

   ONE JUDGEMENT CALL CARRIED OVER FROM VARIANT A: the brief's hero
   subhead did not qualify "one free call-out". The same qualifier used on
   Variant A's hero ("one hour of engineer time, parts quoted separately")
   is added here too, for the same reason — Josh's "do not soften this"
   ruling applies to whichever page states the entitlement, and the hero
   is the most-skimmed surface.

   FIXED 25 Aug 2026, from a QA pass: same leftover as Variant A — the
   "How it works" step 2 line stated the call-out without the qualifier.
   Fixed identically, approved by Josh alongside the outstanding Abbey answers.

   FOOTER: kept to Privacy and Cookies only, same as Variant A, via
   `LpFooter`'s `links` prop. On THIS page the case for staying there is
   stronger, not weaker — see the FLAG below.

   ⚠️ CONFIRMED CONTRADICTION, 25 Aug 2026 — STILL A LAUNCH BLOCKER, now
   worse than an open question. This used to read "confirm Landlord Care
   has its own terms". Abbey's actual answer: no, it doesn't — Landlord
   Care runs on the same Home Care Plan terms (`/homecare-plan-terms/`)
   that state plans are for owned properties and terminate when the
   property is sold. Landlord Care is sold explicitly for LET properties.
   This is not an ambiguity to clear up; it is a live document that
   contradicts the product it is supposed to govern. Fixing it needs Abbey
   (or their solicitor) to actually amend the Home Care Plan Terms to
   address let/tenanted properties — nothing on this page can fix it, and
   nothing has been linked in the footer because there is still no correct
   terms page to point to. Flag this to Josh as needing escalation, not
   just an FYI. See `_Specs/01 OUTSTANDING FROM CLIENT.md`.
   ===================================================================== */

const title = '£342 of Landlord Cover for £13.99 a Month | Abbey Group';
const description =
  'Landlord Care: £342 of annual cover for £13.99 a month in Whitby. Join before 26 September to also enter our free boiler prize draw.';

/* ---- Competition constants ---- identical mechanics to Variant A. */
const DRAW_CLOSE = '26 September 2026';
const DRAW_CLOSE_SHORT = '26 September';
const DEADLINE_ISO = '2026-09-26T23:59:59+01:00';
const conditionsLine =
  'No purchase necessary. Free postal entry available. One entry per person. Draw closes 26 September 2026. Terms apply.';
const TERMS_HREF = '#draw-terms';

const FORM_SOURCE = 'lp-landlord-care-boiler-draw';
const FORM_TAGS = 'homecare,landlord-care,competition,comp-enquired';

const trustReviews = homecareReviews.filter((r) => r.name === 'Angela' || r.name === 'Dan McDermott');

/* ⚠️ Same caveat as Variant A: a trimmed edit of Angela's review, not a
   verbatim excerpt. See that page's file header for the genuine verbatim
   sentence if this needs correcting to it. */
const proofQuote = 'They came within hours when I had no heating. The plan takes the sting out of a big bill.';
const proofReview = homecareReviews.find((r) => r.name === 'Angela');

/* Six questions, four carried over unchanged from Variant A (plan-agnostic,
   no figures to swap) and the first one updated to Landlord Care's figure. */
const drawFaqs = [
  {
    q: 'What does £13.99 a month cover?',
    a: 'Your annual boiler service, a gas safety certificate, a heating health check and priority response, every year, on every property you let. One free call-out a year, one hour of engineer time included, parts quoted separately. It is a service plan looked after by the same local team.',
  },
  {
    q: 'How do I enter the draw?',
    a: `Join any Abbey Group homecare plan before ${DRAW_CLOSE} and you are entered automatically once the plan is active. You do not have to join to enter: you can also enter free by post, with no plan needed.`,
  },
  {
    q: 'When is the draw?',
    a: `We draw one winner after entries close on ${DRAW_CLOSE} and fit their new boiler. It is a chance to win, not a guarantee.`,
  },
  {
    q: 'Can I cancel?',
    a: 'Yes, any time. There is no minimum term and no cancellation fee, and if you change your mind within 14 days you get a full refund.',
  },
  {
    /* ⚠️ [CONFIRM WITH ABBEY] final wording, per Variant A's brief. */
    q: 'What is not covered?',
    a: 'Your plan covers the annual service, gas safety certificate, flue gas analysis, filter clean, radiator balance, health check and one call-out a year with one hour of engineer time. Parts, and any second call-out in the same year, are charged separately, and we will always tell you the cost before we do the work. Faults that already exist when you join are not covered.',
  },
  {
    q: 'Will I get a hard sell on the call?',
    a: 'No. We ring, explain the plan, answer your questions, and set you up if you want it. If you do not, that is the end of it.',
  },
];
---
<BaseLayout
  title={title}
  description={description}
  noindex={true}
  chromeless={true}
  division="homecare"
  footerLinks={['privacy', 'cookies']}
>
  <!-- 1. HERO -->
  <section class="hero" id="entry">
    <div class="container hero__grid">
      <div class="hero__lead">
        <p class="hero__eyebrow">Abbey Landlord Care, Whitby</p>
        <h1 class="hero__h1">£342 of work, for £13.99 a month</h1>
        <!-- ⚠️ Judgement call, see file header: qualifier added to "one free
             call-out" for the same reason as Variant A's hero. -->
        <p class="hero__sub">
          Landlord Care covers your gas safety certificate, full boiler service, health check
          and one free call-out (one hour of engineer time, parts quoted separately) on every
          property you let. Join before {DRAW_CLOSE_SHORT} and you are also in the draw for a
          brand new boiler, worth £2,800.
        </p>

        <div class="cd" data-deadline={DEADLINE_ISO}>
          <span class="cd__label">Entries close {DRAW_CLOSE_SHORT}</span>
          <span class="cd__timer" hidden>
            <span class="cd__box"><b class="cd__d">0</b><i>days</i></span>
            <span class="cd__box"><b class="cd__h">0</b><i>hrs</i></span>
            <span class="cd__box"><b class="cd__m">0</b><i>mins</i></span>
          </span>
        </div>

        <div class="hero__cta">
          <Button href="#enquiry" size="lg">Get Me Covered</Button>
          <a class="hero__call" href={`tel:${nap.phone.tel}`}>or call the Whitby office on {nap.phone.label}</a>
        </div>

        <p class="hero__trust">
          <Icon name="badge-check" size={16} />
          <span>Gas Safe {site.gasSafeNo} · Whitby's own since 2008 · {ratings.google.value} from {ratings.google.count} Google reviews</span>
        </p>
      </div>

      <div class="hero__panel">
        <!-- ⚠️ PLACEHOLDER: swap for a clean product shot of the actual
             prize boiler on a white background once the prize is confirmed.
             Use this exact string as the <Photo> `alt` on swap:
             "Ideal Logic Max boiler, the prize in the Abbey Home Care draw" -->
        <PhotoSlot
          class="hero__prize"
          ratio="4 / 5"
          radius="lg"
          caption="Ideal Logic Max boiler, the prize in the Abbey Home Care draw"
        />
      </div>

      <div class="hero__foot">
        <p class="hero__cond">{conditionsLine} <a href={TERMS_HREF}>Full terms</a>.</p>
      </div>
    </div>
  </section>

  <!-- 2. PAIN -->
  <Section bg="white">
    <div class="pain reveal">
      <Eyebrow>Why the plan exists</Eyebrow>
      <h2 class="h2">The certificate is your job, not your tenant's</h2>
      <p class="pain__p">
        Every property you let needs a gas safety certificate every year. Remembering it,
        booking it and chasing it is on you.
      </p>
      <p class="pain__p">
        So most landlords book it late, pay a call-out price for the privilege, then do exactly
        the same thing again next year.
      </p>
      <p class="pain__p">
        Landlord Care puts it on a schedule. We contact you when the service is due, and the
        certificate comes with it.
      </p>
      <a class="textcta" href="#enquiry">Get Me Covered</a>
    </div>
  </Section>

  <!-- 3. OFFER STACK — figures confirmed against `02 PLAN DATA`. The three
       "included" rows carry over from Variant A unchanged: Landlord Care
       has the same inclusions as Service Care, just a higher certificate
       cost, which is why only the priced rows and the total change. -->
  <Section bg="sunken">
    <div class="stack reveal">
      <Eyebrow>What £13.99 a month gets you</Eyebrow>
      <h2 class="h2">Everything included, every year</h2>

      <ul class="stack__list">
        <li><span>Full boiler service and gas safety certificate</span><b class="tnum">£162</b></li>
        <li><span>Heating health check and filter clean</span><b class="tnum">£66</b></li>
        <li><span>One free call-out, one hour of engineer time</span><b class="tnum">£114</b></li>
        <li><span>Flue gas analysis, filter clean, radiators balanced</span><b class="tnum">Included</b></li>
        <li><span>Priority response, weekdays</span><b class="tnum">Included</b></li>
        <li><span>5% off any other work</span><b class="tnum">Included</b></li>
        <li class="stack__total"><span>Total value</span><b class="tnum">£342</b></li>
      </ul>

      <div class="stack__anchor">
        <div class="stack__arow stack__arow--was">
          <span class="stack__alabel">Paid for separately</span>
          <span class="stack__anum">£342</span>
        </div>
        <div class="stack__arow stack__arow--now">
          <span class="stack__alabel">Landlord Care</span>
          <span class="stack__anum stack__anum--now">£13.99<span class="stack__amo">/mo</span></span>
          <span class="stack__athen">£167.88 a year</span>
        </div>
        <p class="stack__save">You save £174.</p>
      </div>

      <!-- ⚠️ [CONFIRM WITH ABBEY] wording per Variant A's brief, before publishing. -->
      <p class="stack__small">
        Parts are quoted separately and we will always tell you the cost before we do the
        work. Priority response covers weekday call-outs, 9am to 5pm Monday to Friday.
      </p>
      <p class="stack__risk">No minimum term. Cancel any month you like. Full refund if you change your mind within 14 days.</p>

      <div class="ctarow reveal">
        <Button href="#enquiry" size="lg">Get Me Covered</Button>
      </div>
    </div>
  </Section>

  <!-- 4. PROOF STRIP — see file header: no landlord-specific review exists,
       Variant A's Angela quote reused deliberately. -->
  <Section bg="white" pad="tight">
    <p class="proof reveal">
      <span class="proof__q">{proofQuote}</span>
      <span class="proof__by">{proofReview?.name}, {proofReview?.source}</span>
    </p>
  </Section>

  <!-- 5. THE FORM -->
  <EnquiryForm
    eyebrow="Get started"
    heading="Leave your number and we will call you back"
    lead="We ring you back to set your plan up or just talk it through, whichever you need. It takes under five minutes, and you can also enter the draw free by post. You enter the draw by joining a plan, not by sending this form."
    source={FORM_SOURCE}
    tags={FORM_TAGS}
    submitLabel="Get Me Covered"
    bg="sunken"
    redirect="/lp/thank-you/"
    planInterest="Landlord Care"
    microNote="We will only use your details to talk to you about your enquiry."
    fields={[
      { name: 'name', label: 'Full name', required: true, autocomplete: 'name' },
      { name: 'phone', label: 'Best number to reach you', type: 'tel', required: true, autocomplete: 'tel' },
      { name: 'email', label: 'Email', required: true, type: 'email', autocomplete: 'email' },
      { name: 'postcode', label: 'Postcode', required: true, autocomplete: 'postal-code' },
    ]}
  >
    <ul class="ef__risk">
      <li><Icon name="check" size={15} /><span>No purchase necessary, enter free by post</span></li>
      <li><Icon name="check" size={15} /><span>Cancel any time, no minimum term</span></li>
      <li><Icon name="check" size={15} /><span>Full refund within 14 days</span></li>
    </ul>
    <p class="ef__talk">
      Prefer to talk? Call
      <a class="tnum" href={`tel:${nap.phone.tel}`}>{nap.phone.label}</a>
      and a real person will answer.
    </p>
  </EnquiryForm>

  <!-- 6. HOW IT WORKS -->
  <Section bg="white">
    <div class="how__head reveal">
      <Eyebrow>How it works</Eyebrow>
      <h2 class="h2">Covered in three steps, and in the draw as well</h2>
    </div>
    <ol class="how__steps reveal">
      <li class="how__step">
        <span class="how__num tnum" aria-hidden="true">1</span>
        <h3 class="how__t">Leave your number</h3>
        <p class="how__d">We ring you back, usually the same day. Under five minutes to set up, nothing to fill in online.</p>
      </li>
      <li class="how__step">
        <span class="how__num tnum" aria-hidden="true">2</span>
        <h3 class="how__t">Your cover starts</h3>
        <p class="how__d">Annual service, gas safety certificate, health check and one free call-out (one hour of engineer time, parts quoted separately), £13.99 a month. Cancel any month you like.</p>
      </li>
      <li class="how__step">
        <span class="how__num tnum" aria-hidden="true">3</span>
        <h3 class="how__t">You are in the draw</h3>
        <p class="how__d">Every active plan before {DRAW_CLOSE_SHORT} goes into the draw for a brand new Ideal Logic Max boiler, worth £2,800, fitted free. One winner, drawn after entries close. One entry per person.</p>
      </li>
    </ol>

    <div class="postal reveal">
      <div>
        <h3 class="postal__t">Prefer not to join? Enter free by post</h3>
        <p class="postal__d">
          Send a postcard with your name, address, phone number and email, marked
          <strong>Boiler Draw entry</strong>. One entry per person, and it must reach us before
          entries close on {DRAW_CLOSE}.
        </p>
      </div>
      <address class="postal__addr">{site.legalName}<br />{nap.addressFull}</address>
    </div>

    <div class="ctarow reveal">
      <Button href="#enquiry" size="lg">Get Me Covered</Button>
      <span class="ctarow__note">Entries close {DRAW_CLOSE_SHORT}</span>
    </div>
  </Section>

  <!-- 7. WHO YOU ARE DEALING WITH — unchanged, per Variant A's "do not touch it". -->
  <Section bg="sunken">
    <div class="why">
      <div class="why__copy reveal">
        <Eyebrow>Who you are dealing with</Eyebrow>
        <h2 class="h2">A Whitby firm, not a call centre</h2>
        <p class="why__lead">
          When you ring, someone in the Skinner Street office picks up. When the engineer turns up,
          it is one of the same handful of people every year, looking after boilers here since 2008.
        </p>
        <ul class="why__facts">
          <li><Icon name="badge-check" size={16} /><span>Gas Safe registered, number {site.gasSafeNo}</span></li>
          <li><Icon name="badge-check" size={16} /><span>Working in Whitby since 2008</span></li>
          <li><Icon name="badge-check" size={16} /><span>{ratings.google.value} from {ratings.google.count} Google reviews</span></li>
        </ul>
      </div>
      <div class="why__media reveal">
        <Photo
          src="/images/about-team-group.webp"
          alt="The Abbey Group team with their vans in Whitby"
          ratio="4 / 3"
        />
        <figure class="why__person">
          <img src="/images/about-james-eddon-headshot.webp" alt="James Eddon, Managing Director of Abbey Group" width="60" height="60" loading="lazy" decoding="async" />
          <figcaption>
            <strong>James Eddon</strong>
            <span>Managing Director. Set the business up as Abbey Gas in 2008.</span>
          </figcaption>
        </figure>
      </div>
    </div>

    <ul class="why__reviews reveal">
      {trustReviews.map((r) => (
        <li class="why__review">
          <p class="why__quote">{r.quote}</p>
          <p class="why__by"><span>{r.name}</span>, {r.source}</p>
        </li>
      ))}
    </ul>

    <div class="ctarow reveal">
      <Button href="#enquiry" size="lg">Get Me Covered</Button>
      <span class="ctarow__note">Entries close {DRAW_CLOSE_SHORT}</span>
    </div>
  </Section>

  <!-- 8. JOINING OFFER — the £162 one-off figure here is the landlord gas
       safety check's own single-visit price (confirmed in `02 PLAN DATA`,
       the same source as the offer stack's first row), not a guess: it
       keeps this card consistent with the £342 total above it, the way
       Variant A's £96 one-off matched its own £276 total. -->
  <Section bg="dark" bleed>
    <div class="offer">
      <img class="offer__mark" src="/brand/crescent/mark-homecare.svg" alt="" aria-hidden="true" width="360" height="378" />
      <div class="container offer__inner reveal">
        <div class="offer__copy">
          <Eyebrow tone="inverse">The joining offer</Eyebrow>
          <h2 class="offer__h2">Already booking your gas safety check? Turn it into cover for good.</h2>
          <p class="offer__lead">
            The engineer is coming anyway. Join Landlord Care instead of paying for a one-off
            visit, and this certificate is included today, and every year after, for £13.99 a month.
          </p>
          <p class="offer__guar">
            Stay because it is working, not because you are stuck. No minimum term, cancel any
            month you like, and a full refund if you change your mind within 14 days.
          </p>
          <p class="offer__pricing">Plans from £13.99 a month, and we will talk you through them on the call.</p>
        </div>

        <div class="offer__card">
          <div class="offer__row offer__row--was">
            <span class="offer__label">Landlord safety check, one-off</span>
            <span class="offer__num tnum">£162</span>
          </div>
          <div class="offer__row offer__row--now">
            <span class="offer__label">Landlord Care, from today</span>
            <span class="offer__num tnum">£13.99<span class="offer__mo">/mo</span></span>
            <span class="offer__then">this certificate included every year</span>
          </div>
        </div>
      </div>

      <div class="container ctarow ctarow--dark reveal">
        <Button href="#enquiry" variant="primary" size="lg">Get Me Covered</Button>
        <span class="ctarow__note">Entries close {DRAW_CLOSE_SHORT}</span>
      </div>
    </div>
  </Section>

  <!-- 9. FAQ -->
  <FAQ
    eyebrow="Good to know"
    heading="Six quick questions"
    items={drawFaqs}
    bg="white"
  />

  <!-- 10. FINAL CTA -->
  <Section bg="sunken">
    <div class="final reveal">
      <h2 class="final__h2">Ready to get covered before the draw closes?</h2>
      <p class="final__lead">
        Join Landlord Care from £13.99 a month before {DRAW_CLOSE} and you are entered into the
        draw. No purchase necessary, and you can also enter free by post.
      </p>
      <div class="ctarow ctarow--center">
        <Button href="#enquiry" size="lg">Get Me Covered</Button>
        <span class="ctarow__note">Entries close {DRAW_CLOSE_SHORT}</span>
      </div>
    </div>
  </Section>

  <!-- 11. PRIZE DRAW TERMS — unchanged, same prize regardless of plan. -->
  <Section bg="white" id="draw-terms">
    <div class="drawterms">
      <h2 class="drawterms__h2">Prize draw terms</h2>
      <p class="drawterms__line">{conditionsLine}</p>
      <ul class="drawterms__list">
        <li>Promoter: {site.legalName}, company no. {site.companyNo}, {nap.addressFull}.</li>
        <li>Enter by joining any Abbey Group homecare plan that is active before entries close on {DRAW_CLOSE}, or free by post to the address above.</li>
        <li>One entry per person. The prize is one new Ideal Logic Max boiler (combi, system or heat-only, whichever suits the winner's property), natural gas or LPG only, with a Wifi HALO thermostat, supplied and installed by Abbey Group, worth £2,800. A cash alternative of £2,500 may be offered if the property is unsuitable for a boiler or the winner prefers it.</li>
        <li>The winner is drawn after entries close and will be contacted using the details provided.</li>
        <li>Read the <a href={routes.drawTerms}>full prize draw terms</a>, or ask for them at the office.</li>
      </ul>
    </div>
  </Section>

  <!-- 12. FOOTER — Privacy and Cookies only, via BaseLayout's `footerLinks`
       prop above. See the file header FLAG: the Home Care Plan Terms page
       is not confirmed to cover let properties, so it is not linked from
       here at all, not even alongside the other two. -->
</BaseLayout>

<style>
  .h2 { font-size: clamp(30px, 3vw, 44px); color: var(--text-heading); margin-top: 10px; }

  /* ---- 1. HERO ---------------------------------------------------------- */
  .hero {
    position: relative;
    overflow: hidden;
    color: var(--white);
    padding: 120px var(--container-padding) 64px;
    background:
      radial-gradient(1000px 640px at 82% 12%, color-mix(in oklch, var(--page-accent-glow, var(--orange-900)) 60%, transparent) 0%, transparent 62%),
      radial-gradient(760px 520px at 4% 96%, color-mix(in oklch, var(--page-accent, var(--orange-500)) 14%, transparent) 0%, transparent 60%),
      var(--surface-page-dark, var(--ink-500));
  }
  .hero::after {
    content: '';
    position: absolute; inset: auto 0 0 0; height: 3px;
    background: var(--page-accent, var(--orange-500)); opacity: 0.9;
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    grid-template-areas: "lead panel" "foot panel";
    column-gap: 56px;
    row-gap: 28px;
    align-items: start;
  }
  .hero__lead { grid-area: lead; }
  .hero__panel { grid-area: panel; display: flex; flex-direction: column; justify-content: center; }
  .hero__foot { grid-area: foot; align-self: end; }

  .hero__eyebrow {
    font-size: 12.5px; font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider); text-transform: uppercase;
    color: var(--text-muted-inverse);
  }
  .hero__h1 {
    margin-top: 14px;
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(38px, 4.6vw, 60px); line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight); text-wrap: balance; color: var(--white);
  }
  .hero__sub {
    margin-top: 18px; max-width: 48ch;
    font-size: var(--text-md); line-height: var(--leading-relaxed);
    color: var(--text-body-inverse);
  }

  .cd {
    display: flex; flex-wrap: wrap; align-items: center; gap: 14px;
    margin-top: 24px; padding: 14px 18px;
    background: color-mix(in oklch, var(--white) 8%, transparent);
    border: 1px solid color-mix(in oklch, var(--page-accent, var(--orange-500)) 45%, transparent);
    border-radius: var(--radius-lg);
  }
  .cd__label {
    font-size: 14px; font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide); text-transform: uppercase;
    color: var(--page-accent-on-dark, var(--orange-400));
  }
  .cd__timer { display: inline-flex; gap: 10px; }
  .cd__box {
    display: inline-flex; flex-direction: column; align-items: center;
    min-width: 46px; padding: 6px 8px;
    background: color-mix(in oklch, var(--white) 10%, transparent);
    border-radius: var(--radius-md);
  }
