  .trust { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px; align-items: start; }
  .trust__lead { margin-top: 18px; font-size: var(--text-base); line-height: var(--leading-relaxed); color: var(--text-body); }
  .trust__list { display: flex; flex-direction: column; gap: 16px; margin-top: 28px; }
