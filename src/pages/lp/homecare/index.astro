  .score__label { margin-top: 8px; font-size: 14.5px; line-height: var(--leading-relaxed); color: var(--text-body-inverse); max-width: 340px; }

  /* ---- 11. FORM SLOT ---- */
  .ef__risk { display: flex; flex-direction: column; gap: 9px; margin-top: 4px; }
  .ef__risk li { display: flex; gap: 10px; align-items: center; font-size: 14.5px; font-weight: var(--weight-medium); color: var(--text-heading); }
  .ef__risk :global(svg) { color: var(--page-accent-ink, var(--orange-800)); flex: none; }
  .ef__talk { font-size: var(--text-sm); line-height: var(--leading-relaxed); color: var(--text-muted); }
  .ef__talk a { color: var(--text-link); font-weight: var(--weight-bold); white-space: nowrap; }

  @media (max-width: 1024px) {
    .coi { grid-template-columns: 1fr; gap: 32px; }
    /* 3 -> 2, never 3 -> 1: six divides evenly by both, so there is no ragged
       final row at either step (standing rule 12). */
    .get__grid { grid-template-columns: repeat(2, 1fr); }
    .get__foot { grid-template-columns: 1fr; gap: 24px; }
    .plans__grid { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; }
