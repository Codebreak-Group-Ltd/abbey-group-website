---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import Eyebrow from '../../../components/Eyebrow.astro';
import Button from '../../../components/Button.astro';
import Icon from '../../../components/Icon.astro';
import PhotoSlot from '../../../components/PhotoSlot.astro';
import FAQ from '../../../components/FAQ.astro';
import EnquiryForm from '../../../components/EnquiryForm.astro';
import Photo from '../../../components/Photo.astro';
import { nap, site, ratings, homecareReviews } from '../../../data/site.ts';

/* =====================================================================
   /lp/homecare-boiler-draw/ — Homecare BOILER-DRAW campaign landing page.
   Rebuilt 12 August 2026 as a lean giveaway lead-gen page (Josh): the first
   build read as a brochure. ONE message and ONE action. The prize leads: the
   hero is prize image + headline + countdown + one big CTA that jumps to the
   single form directly below it (the form is NOT in the hero — on a giveaway
   the prize is the hook, and a form up there fought it and would not fit above
   the mobile fold). The deadline is prominent, and half the old sections are gone.

   WHAT WAS CUT, and why it is fine: the plan-picker quiz, the three-plan
   pricing grid with buy buttons, the six-point service grid and the
   without/with comparison table all came out. A visitor here has clicked an
   advert and is weighing the prize and how easy it is to enter, not comparing
   subscription tiers. Everything cut still lives on `/homecare-plans/` and the
   evergreen `/lp/homecare/`, which are untouched.

   RELATIONSHIP TO `/lp/homecare/`. That is the EVERGREEN homecare LP, run all
   year and built to educate a problem-aware visitor. THIS is its time-boxed,
   conversion-first sibling for the boiler draw. They share the design system
   and the plan facts, not their structure.

   COMPLIANCE, LOAD-BEARING. The form is "get started, we will call you",
   never "you are now entered". Entry into the draw happens only on an actual
   paid sign-up (or a free postal entry), so the giveaway styling must not imply
   the form itself enters anyone — the hero form's own microcopy says so. The
   significant-conditions line, the free-postal-entry block with the office
   address, and the terms link are all present and prominent, not buried.
   No insurance/policy/claim/premium wording anywhere. British English, no
   em dashes, no exclamation marks.

   FUNNEL. A form submission is interest, not entry, so it posts to
   PUBLIC_GHL_WEBHOOK then to `/thank-you/` ("thanks, we have got your
   details") and joins the lead/nurture path. UTMs travel with it via
   EnquiryForm's read-at-submit attribution (no hidden fields, no device
   storage — the deliberate PECR-safe pattern, see EnquiryForm.astro).

   ONE FORM, MANY CTAs. There is a single EnquiryForm, directly under the hero
   (id="enquiry"). Every CTA on the page — the hero button, the between-section
   rows, the final CTA — is a link to #enquiry that jumps to it. EnquiryForm's
   own script handles submit/webhook/redirect.

   HELD, do not build yet: the self-serve sign-up/payment path and its "you are
   in" thank-you (pending Amy on site payment); the landlord variant (pending
   James). Tracking/consent is a separate task (Josh, 12 August 2026); nothing
   tracking-related fires here.

   PLACEHOLDERS pending the solicitor: the significant-conditions wording and
   the full-terms link (see the constants below). Pending the prize being
   confirmed: the hero prize image is a PhotoSlot, to be swapped for a clean
   product shot of the actual boiler on a white background. Launch also needs
   the live GHL webhook URL.
   ===================================================================== */

const title = 'Win a New Boiler | Homecare from £9.99 a Month | Abbey Group';
const description =
  'Join an Abbey Group homecare plan before 26 September to enter our free draw to win a new boiler. Gas Safe cover in Whitby from £9.99 a month.';

/* ---- Competition constants ----
   ⚠️ `conditionsLine` is PLACEHOLDER wording. Replace with the solicitor's
   exact short-form conditions before launch. The mechanic, the date and the
   free route are correct; only the precise legal phrasing is pending.
   Dates corrected 19 Aug 2026: 18 Aug decision moved the open day to
   19 September and the draw itself to 26 September (see Launch Readiness
   Checklist) — this page previously still had the old 19 Sep close date. */
const DRAW_CLOSE = '26 September 2026';
const DRAW_CLOSE_SHORT = '26 September';
const DEADLINE_ISO = '2026-09-26T23:59:59';
const conditionsLine =
  'No purchase necessary. Free postal entry available. One entry per person. Draw closes 26 September 2026. Terms apply.';
const TERMS_HREF = '#draw-terms';

/* Shared form attributes, so the hero form and the final-CTA form stay in step. */
const FORM_SOURCE = 'lp-homecare-boiler-draw';
const FORM_TAGS = 'homecare,boiler-cover,competition,comp-enquired';

/* Two verified reviews for the short trust block, verbatim from the master
   (convention 8). Angela evidences priority response, Dan the whole job. */
const trustReviews = homecareReviews.filter((r) => r.name === 'Angela' || r.name === 'Dan McDermott');

/* Short, competition-specific FAQ. Four questions, no more. Kept local rather
   than reusing the evergreen set because these answer the draw, not the plans.
   No page-level FAQPage schema is emitted (this is an LP). */
const drawFaqs = [
  {
    q: 'What does £9.99 a month cover?',
    a: 'Your annual boiler service, a gas safety certificate, a heating health check, priority response and one free call-out, every year you are covered. It is a service plan looked after by the same local team.',
  },
  {
    q: 'How do I enter the draw?',
    a: `Join any Abbey Group homecare plan before ${DRAW_CLOSE} and you are entered automatically once the plan is active. You do not have to join to enter: you can also enter free by post, with no plan needed.`,
  },
  {
    q: 'When is the draw?',
    a: `We draw one winner after entries close on ${DRAW_CLOSE} and fit their new boiler. It is a chance to win, not a guarantee.`,
  },
  {
    q: 'Can I cancel?',
    a: 'Yes, any time. There is no minimum term and no cancellation fee, and if you change your mind within 14 days you get a full refund.',
  },
];
---
<BaseLayout
  title={title}
  description={description}
  noindex={true}
  chromeless={true}
  division="homecare"
>
  <!-- 1. HERO — prize leads. The form is NOT in the hero (Josh, 12 August
       2026): on a giveaway the prize is the emotional driver, and a four-field
       form up here fought it and would not fit above the mobile fold alongside
       the headline and prize image. So the hero is prize image + headline +
       countdown + one big CTA that jumps to the form directly below. That keeps
       the CTA unmistakably above the fold on mobile, where most traffic lands.

       Grid areas, not source order: the MOBILE stack is lead, panel, foot, so
       the headline, countdown and CTA button come first (above the fold) and the
       prize image sits just under them. Desktop keeps copy+CTA left, image right. -->
  <section class="hero" id="entry">
    <div class="container hero__grid">
      <div class="hero__lead">
        <p class="hero__eyebrow">Abbey Group homecare · Whitby</p>
        <h1 class="hero__h1">Win a New Boiler for Your Home</h1>
        <!-- ⚠️ Add the real, verifiable prize value when confirmed
             (for example "a boiler supplied and fitted, worth £X"). Do NOT ship
             a placeholder figure: an unverifiable prize value is a compliance
             risk on a prize draw. -->
        <p class="hero__sub">
          Join an Abbey Group homecare plan before 26 September and you are entered into the draw
          for a new Ideal Logic Max boiler, worth £2,800, supplied and installed by Abbey Group.
          Cover starts at £9.99 a month.
        </p>

        <!-- Deadline, prominent. The label is the no-JS fallback; the countdown
             is filled in and revealed by the script at the foot of the page. -->
        <div class="cd" data-deadline={DEADLINE_ISO}>
          <span class="cd__label">Entries close {DRAW_CLOSE_SHORT}</span>
          <span class="cd__timer" hidden>
            <span class="cd__box"><b class="cd__d">0</b><i>days</i></span>
            <span class="cd__box"><b class="cd__h">0</b><i>hrs</i></span>
            <span class="cd__box"><b class="cd__m">0</b><i>mins</i></span>
          </span>
        </div>

        <div class="hero__cta">
          <Button href="#enquiry" size="lg">Get Me Covered</Button>
          <a class="hero__call" href={`tel:${nap.phone.tel}`}>or call the office on {nap.phone.label}</a>
        </div>
      </div>

      <div class="hero__panel">
        <!-- ⚠️ PLACEHOLDER: swap for a clean product shot of the actual prize
             boiler on a white background once the prize is confirmed. Portrait,
             because a boiler is a tall unit and it balances the copy column.
             Not a lifestyle kitchen photo. -->
        <PhotoSlot
          class="hero__prize"
          ratio="4 / 5"
          radius="lg"
          caption="Prize boiler image to follow: a clean product shot of the Ideal Logic Max, worth £2,800, on a white background"
        />
      </div>

      <div class="hero__foot">
        <p class="hero__trust">
          <Icon name="star" size={16} />
          <span>{ratings.google.value} from {ratings.google.count} Google reviews · Whitby's own since 2008</span>
        </p>
        <p class="hero__cond">{conditionsLine} <a href={TERMS_HREF}>Full terms</a>.</p>
      </div>
    </div>
  </section>

  <!-- 1b. THE FORM — the single conversion point, directly under the hero so the
       hero CTA jumps straight to it. Every other CTA on the page targets it too
       (#enquiry). It carries the load-bearing compliance line the hero form used
       to: this is a callback request, and entry happens on joining, not on
       submit. EnquiryForm's script wires it and posts to the webhook then
       /thank-you/. -->
  <EnquiryForm
    eyebrow="Enter in under a minute"
    heading="Leave your details and we will call you back"
    lead="We ring you back to set your plan up or talk it through, whichever you need. It takes under a minute, and you can also enter free by post. You enter the draw by joining a plan, not by sending this form."
    source={FORM_SOURCE}
    tags={FORM_TAGS}
    submitLabel="Get Me Covered"
    bg="sunken"
    redirect="/thank-you/"
    fields={[
      { name: 'name', label: 'Full name', required: true, autocomplete: 'name' },
      { name: 'phone', label: 'Phone', type: 'tel', required: true, autocomplete: 'tel' },
      { name: 'email', label: 'Email', type: 'email', required: true, autocomplete: 'email' },
      { name: 'postcode', label: 'Postcode', autocomplete: 'postal-code' },
    ]}
  >
    <ul class="ef__risk">
      <li><Icon name="check" size={15} /><span>No purchase necessary, enter free by post</span></li>
      <li><Icon name="check" size={15} /><span>Cancel any time, no minimum term</span></li>
      <li><Icon name="check" size={15} /><span>Full refund within 14 days</span></li>
    </ul>
    <p class="ef__talk">
      Prefer to talk? Call the Whitby office on
      <a class="tnum" href={`tel:${nap.phone.tel}`}>{nap.phone.label}</a>
      and a real person will answer.
    </p>
  </EnquiryForm>

  <!-- 2. HOW IT WORKS — three short steps. -->
  <Section bg="white">
    <div class="how__head reveal">
      <Eyebrow>How it works</Eyebrow>
      <h2 class="h2">Three steps to your chance at a new boiler</h2>
    </div>
    <ol class="how__steps reveal">
      <li class="how__step">
        <span class="how__num tnum" aria-hidden="true">1</span>
        <h3 class="how__t">Join a homecare plan</h3>
        <p class="how__d">Start any plan before {DRAW_CLOSE_SHORT}, from £9.99 a month. We set it up with you on a quick call.</p>
      </li>
      <li class="how__step">
        <span class="how__num tnum" aria-hidden="true">2</span>
        <h3 class="how__t">You are entered</h3>
        <p class="how__d">Once your plan is active we add you to the draw. One entry per person, and there is nothing else to fill in.</p>
      </li>
      <li class="how__step">
        <span class="how__num tnum" aria-hidden="true">3</span>
        <h3 class="how__t">Winner drawn {DRAW_CLOSE_SHORT}</h3>
        <p class="how__d">We draw one winner when entries close and fit their new boiler. A chance to win, not a guarantee.</p>
      </li>
    </ol>

    <!-- Free postal route, genuinely on the page (no purchase necessary). -->
    <div class="postal reveal">
      <div>
        <h3 class="postal__t">Prefer not to join? Enter free by post</h3>
        <p class="postal__d">
          Send a postcard with your name, address, phone number and email, marked
          <strong>Boiler Draw entry</strong>. One entry per person, and it must reach us before
          entries close on {DRAW_CLOSE}.
        </p>
      </div>
      <address class="postal__addr">{site.legalName}<br />{nap.addressFull}</address>
    </div>

    <div class="ctarow reveal">
      <Button href="#enquiry" size="lg">Get Me Covered</Button>
      <span class="ctarow__note">Entries close {DRAW_CLOSE_SHORT}</span>
    </div>
  </Section>

  <!-- 3. WHY ABBEY — short: the "not a call centre" line, a real team/James photo
       (only James has a headshot; the rest of the team is shown as they actually
       are, in the group-and-fleet photograph — same rule as `/lp/homecare/`, no
       stock faces), plus two real reviews. -->
  <Section bg="sunken">
    <div class="why">
      <div class="why__copy reveal">
        <Eyebrow>Who you are dealing with</Eyebrow>
        <h2 class="h2">A Whitby firm, not a call centre</h2>
        <p class="why__lead">
          When you ring, someone in the Skinner Street office picks up. When the engineer turns up,
          it is one of the same handful of people every year, looking after boilers here since 2008.
        </p>
        <ul class="why__facts">
          <li><Icon name="badge-check" size={16} /><span>Gas Safe registered, number {site.gasSafeNo}</span></li>
          <li><Icon name="badge-check" size={16} /><span>Working in Whitby since 2008</span></li>
          <li><Icon name="badge-check" size={16} /><span>{ratings.google.value} from {ratings.google.count} Google reviews</span></li>
        </ul>
      </div>
      <div class="why__media reveal">
        <Photo
          src="/images/about-team-group.webp"
          alt="The Abbey Group team with their vans in Whitby"
          ratio="4 / 3"
        />
        <figure class="why__person">
          <img src="/images/about-james-eddon-headshot.webp" alt="James Eddon, Managing Director of Abbey Group" width="60" height="60" loading="lazy" decoding="async" />
          <figcaption>
            <strong>James Eddon</strong>
            <span>Managing Director. Set the business up as Abbey Gas in 2008.</span>
          </figcaption>
        </figure>
      </div>
    </div>

    <ul class="why__reviews reveal">
      {trustReviews.map((r) => (
        <li class="why__review">
          <p class="why__quote">{r.quote}</p>
          <p class="why__by"><span>{r.name}</span>, {r.source}</p>
        </li>
      ))}
    </ul>

    <div class="ctarow reveal">
      <Button href="#enquiry" size="lg">Get Me Covered</Button>
      <span class="ctarow__note">Entries close {DRAW_CLOSE_SHORT}</span>
    </div>
  </Section>

  <!-- 4. THE OFFER — retired as a discount (17 Aug 2026): there is no £48 and no
       separate joining charge. Service Care is £9.99 a month and simply includes
       the annual service, this one and every one after. Presented as an honest
       one-off-vs-plan choice. -->
  <Section bg="dark" bleed>
    <div class="offer">
      <img class="offer__mark" src="/brand/crescent/mark-homecare.svg" alt="" aria-hidden="true" width="360" height="378" />
      <div class="container offer__inner reveal">
        <div class="offer__copy">
          <Eyebrow tone="inverse">The joining offer</Eyebrow>
          <h2 class="offer__h2">Already booking a service? Turn it into cover for good.</h2>
          <p class="offer__lead">
            The engineer is coming anyway. Start Service Care instead of paying for a one-off
            visit, and this service is included today, and every year after, for £9.99 a month.
          </p>
          <p class="offer__guar">
            Stay because it is working, not because you are stuck. No minimum term, cancel any
            month you like, and a full refund if you change your mind within 14 days.
          </p>
          <p class="offer__pricing">Plans from £9.99 a month, and we will talk you through them on the call.</p>
        </div>

        <div class="offer__card">
          <div class="offer__row offer__row--was">
            <span class="offer__label">Boiler service, one-off</span>
            <span class="offer__num tnum">£96</span>
          </div>
          <div class="offer__row offer__row--now">
            <span class="offer__label">Service Care, from today</span>
            <span class="offer__num tnum">£9.99<span class="offer__mo">/mo</span></span>
            <span class="offer__then">this service included every year</span>
          </div>
        </div>
      </div>

      <div class="container ctarow ctarow--dark reveal">
        <Button href="#enquiry" variant="primary" size="lg">Get Me Covered</Button>
        <span class="ctarow__note">Entries close {DRAW_CLOSE_SHORT}</span>
      </div>
    </div>
  </Section>

  <!-- 5. SHORT FAQ — four questions. FAQ renders its own section (white). -->
  <FAQ
    eyebrow="Good to know"
    heading="Four quick questions"
    items={drawFaqs}
    bg="white"
  />

  <!-- 6. FINAL CTA — a button back to the single form, for readers who reach the
       end. Not a second form: the page has one form (under the hero), and every
       CTA jumps to it. -->
  <Section bg="sunken">
    <div class="final reveal">
      <h2 class="final__h2">Ready for your chance at a new boiler?</h2>
      <p class="final__lead">
        Join before {DRAW_CLOSE}, from £9.99 a month, and you are entered into the draw. No
        purchase necessary, and you can also enter free by post.
      </p>
      <div class="ctarow ctarow--center">
        <Button href="#enquiry" size="lg">Get Me Covered</Button>
        <span class="ctarow__note">Entries close {DRAW_CLOSE_SHORT}</span>
      </div>
    </div>
  </Section>

  <!-- DRAW TERMS — the "Full terms" anchor target and the foot-of-page
       restatement of the significant conditions. Placeholder wording pending
       the solicitor; the significant conditions are carried in full so the page
       stands on its own, and `TERMS_HREF` is never a dead link. -->
  <Section bg="white" id="draw-terms">
    <div class="drawterms">
      <h2 class="drawterms__h2">Prize draw terms</h2>
      <p class="drawterms__line">{conditionsLine}</p>
      <ul class="drawterms__list">
        <li>Promoter: {site.legalName}, company no. {site.companyNo}, {nap.addressFull}.</li>
        <li>Enter by joining any Abbey Group homecare plan that is active before entries close on {DRAW_CLOSE}, or free by post to the address above.</li>
        <li>One entry per person. The prize is one new Ideal Logic Max boiler (combi, system or heat-only, whichever suits the winner's property), natural gas or LPG only, with a Wifi HALO thermostat, supplied and installed by Abbey Group, worth £2,800. A cash alternative of £2,500 may be offered if the property is unsuitable for a boiler or the winner prefers it.</li>
        <li>The winner is drawn after entries close and will be contacted using the details provided.</li>
        <li>Full terms and conditions are available from the office on request, and the complete written terms will be published here before the campaign goes live.</li>
      </ul>
    </div>
  </Section>
</BaseLayout>

<style>
  .h2 { font-size: clamp(30px, 3vw, 44px); color: var(--text-heading); margin-top: 10px; }

  /* ---- 1. HERO ---------------------------------------------------------- */
  .hero {
    position: relative;
    overflow: hidden;
    color: var(--white);
    padding: 120px var(--container-padding) 64px;
    background:
      radial-gradient(1000px 640px at 82% 12%, color-mix(in oklch, var(--page-accent-glow, var(--orange-900)) 60%, transparent) 0%, transparent 62%),
      radial-gradient(760px 520px at 4% 96%, color-mix(in oklch, var(--page-accent, var(--orange-500)) 14%, transparent) 0%, transparent 60%),
      var(--surface-page-dark, var(--ink-500));
  }
  .hero::after {
    content: '';
    position: absolute; inset: auto 0 0 0; height: 3px;
    background: var(--page-accent, var(--orange-500)); opacity: 0.9;
  }

  /* Desktop: copy left (lead over foot), prize+form panel right. Mobile: the
     source order (lead, panel, foot) stacks, so headline, deadline and form
     land above the fold. */
  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    grid-template-areas: "lead panel" "foot panel";
    column-gap: 56px;
    row-gap: 28px;
    align-items: start;
  }
  .hero__lead { grid-area: lead; }
  /* Flex column so the prize image and form can be re-ordered when the hero
     stacks (mobile): form first, image below, so the form is reachable without
     scrolling (change ticket 1.4). Desktop keeps source order: image over form. */
  .hero__panel { grid-area: panel; display: flex; flex-direction: column; }
  .hero__foot { grid-area: foot; align-self: end; }

  .hero__eyebrow {
    font-size: 12.5px; font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider); text-transform: uppercase;
    color: var(--text-muted-inverse);
  }
  .hero__h1 {
    margin-top: 14px;
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(38px, 4.6vw, 60px); line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight); text-wrap: balance; color: var(--white);
  }
  .hero__sub {
    margin-top: 18px; max-width: 46ch;
    font-size: var(--text-md); line-height: var(--leading-relaxed);
    color: var(--text-body-inverse);
  }

  /* Deadline / countdown */
  .cd {
    display: flex; flex-wrap: wrap; align-items: center; gap: 14px;
    margin-top: 24px; padding: 14px 18px;
    background: color-mix(in oklch, var(--white) 8%, transparent);
    border: 1px solid color-mix(in oklch, var(--page-accent, var(--orange-500)) 45%, transparent);
    border-radius: var(--radius-lg);
  }
  .cd__label {
    font-size: 14px; font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide); text-transform: uppercase;
    color: var(--page-accent-on-dark, var(--orange-400));
  }
  .cd__timer { display: inline-flex; gap: 10px; }
  .cd__box {
    display: inline-flex; flex-direction: column; align-items: center;
    min-width: 46px; padding: 6px 8px;
    background: color-mix(in oklch, var(--white) 10%, transparent);
    border-radius: var(--radius-md);
  }
  .cd__box b { font-size: 20px; font-weight: var(--weight-bold); line-height: 1; color: var(--white); font-family: var(--font-body); }
  .cd__box i { margin-top: 3px; font-style: normal; font-size: 10px; letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--text-muted-inverse); }

  /* Hero CTA: the big button that jumps to the form, plus a quiet call link. */
  .hero__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 28px; }
  .hero__call { font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--text-body-inverse); text-decoration: underline; text-underline-offset: 3px; }
  .hero__call:hover { color: var(--white); }

  /* Panel: just the portrait prize image, filling the right column. `:global`
     because the class is passed INTO PhotoSlot, so the element carries
     PhotoSlot's scope id, not this page's (Astro scoping gotcha). */
  .hero__panel { justify-content: center; }
  .hero__panel :global(.hero__prize) { width: 100%; max-width: 420px; margin-inline: auto; }

  .hero__foot { display: flex; flex-direction: column; gap: 12px; margin-top: 8px; }
  .hero__trust { display: flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: var(--weight-semibold); color: var(--text-body-inverse); }
  .hero__trust :global(svg) { color: var(--page-accent-on-dark, var(--orange-400)); flex: none; }
  .hero__cond { font-size: 12px; line-height: var(--leading-relaxed); color: var(--text-muted-inverse); max-width: 62ch; }
  .hero__cond a { color: var(--page-accent-on-dark, var(--orange-400)); font-weight: var(--weight-semibold); text-decoration: underline; }

  /* ---- shared: CTA row ------------------------------------------------- */
  .ctarow { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 20px; margin-top: 40px; }
  .ctarow__note { font-size: 13.5px; font-weight: var(--weight-bold); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--page-accent-ink, var(--orange-800)); }
  .ctarow--dark { margin-top: 36px; position: relative; }
  .ctarow--dark .ctarow__note { color: var(--page-accent-on-dark, var(--orange-400)); }
  .ctarow--center { justify-content: center; margin-top: 28px; }

  /* ---- 6. FINAL CTA ---------------------------------------------------- */
  .final { max-width: 640px; margin-inline: auto; text-align: center; }
  .final__h2 { font-size: clamp(28px, 3vw, 40px); color: var(--text-heading); }
