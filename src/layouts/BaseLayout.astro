---
import '../styles/tokens.css';
import '../styles/global.css';

/* Self-hosted fonts (latin subset only) — DM Serif Display 400 + Inter 400/500/600/700.
   NEVER a Google Fonts <link> (render-block + GDPR IP-leak, build standard §5/§7). */
import '@fontsource/dm-serif-display/latin-400.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';

/* PRELOAD the two faces that render above the fold on every page: the display
   serif that sets the H1, and Inter 400 for the lead paragraph. Without these the
   browser cannot discover a font until it has downloaded and parsed the CSS that
   references it, which puts two round trips in front of the largest text on the
   page — fonts are a common LCP and CLS cause, and there were no preloads at all
   before 3 August 2026.

   The `?url` import is what makes this correct rather than fragile: it returns the
   HASHED URL Vite actually emits (`/_astro/inter-latin-400-normal.<hash>.woff2`),
   so the hint can never point at a stale filename after a rebuild. Hand-writing
   the path would break on the next content hash.

   Only these two. Inter 500/600/700 also appear above the fold (buttons, the trust
   row) but in small UI text where a swap is barely visible, and preloading five
   fonts competes with the LCP image for bandwidth, which costs more than it
   saves. */
import dmSerif400 from '@fontsource/dm-serif-display/files/dm-serif-display-latin-400-normal.woff2?url';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LpBar from '../components/LpBar.astro';
import LpFooter from '../components/LpFooter.astro';
import ScrollTop from '../components/ScrollTop.astro';
import PlanPrompt from '../components/PlanPrompt.astro';
import { site } from '../data/site.ts';
import { organization, website } from '../lib/schema.ts';
import { divisionVars, type DivisionKey } from '../data/divisions.ts';

interface Props {
  title: string;
  description: string;
  /** Absolute path for canonical/og:url. Defaults to the current URL. */
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Extra JSON-LD objects for this page (LocalBusiness, Service, FAQPage…). */
  schemas?: object[];
  /** Sub-brand whose colourway themes this page's accents. */
  division?: DivisionKey;
  /* Landing-page chrome: swap the site header, footer and plan prompt for a
     minimal bar and a legal-only footer. Used by `/lp/*` and `/thank-you/`.

     A paid-traffic page has ONE goal, and the site chrome works against it: the
     menu offers ten ways off the page, the header CTA ("Get a Quote") competes
     with the page's own, and the footer's five service links are the largest
     exit ramp on the site. The plan prompt goes too, because the LP already
     makes the half-price offer in a full band of its own.

     Everything in <head> is deliberately kept: canonical, noindex, OG and the
     Organization/WebSite schema all still belong on these pages, and <head> is
     where any future tracking has to live. */
  chromeless?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og/default.png',
  noindex = false,
  schemas = [],
  division = 'group',
  chromeless = false,
} = Astro.props;

const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(ogImage, Astro.site).href;

/* ---- Site-wide schema: Organization + WebSite ----
   Both now live in `src/lib/schema.ts` alongside every other builder, so the
   entity data (knowsAbout, offer catalogue, founder, company number) has one
   home and this layout stays a layout. */
const allSchemas = [organization(), website(), ...schemas];

/* The half-price sign-up offer follows the booking link, not the page, so the
   prompt is mounted SITE-WIDE rather than remembered page by page (Josh, 31 July
   2026: "we are doing people a disservice if we don't offer them this"). It only
   ever reacts to the two specific ServiceM8 links the offer applies to, so it is
   inert everywhere else.

   The one exclusion is the Homecare page itself, where the same offer already
   has a full band and its CTA already says "Book My Service and Start Covered".
   Derived from the URL rather than a prop, so it cannot be forgotten. */
const showPlanPrompt = !chromeless && !Astro.url.pathname.startsWith('/homecare-plans');
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preload" href={dmSerif400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <meta name="theme-color" content="#121037" />

    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>

  <body style={divisionVars(division)} data-division={division} data-chromeless={chromeless ? '' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    {chromeless ? <LpBar division={division} /> : <Header division={division} />}
    <main id="main">
      <slot />
    </main>
    {chromeless ? <LpFooter /> : <Footer division={division} />}
    <ScrollTop />
    {showPlanPrompt && <PlanPrompt />}

    <script>
      /* Hero watermark motion — ONE implementation for every hero on the site
         (the homepage's own mark and PageHero's), so the gesture cannot drift
         apart per page:

           · pointer parallax: the mark's three arcs each drift by their own
             depth as the cursor comes near, and only when it comes near. This is
             the animation that was on the homepage originally (Josh, 29-30 July
             2026). Eased toward the target each frame rather than set directly,
             so it glides instead of snapping.
           · scroll drift: progress through the hero nudges the whole mark down.

         Transform only, both written as custom properties, and the whole thing
         is skipped under reduced motion — where the CSS also forces
         `transform: none`, so the mark simply sits still. */
      (() => {
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const hero = document.querySelector('.hero, [data-phero]');
        const mark = document.querySelector('[data-hero-mark]');
        if (prefersReduced || !hero || !mark) return;

        /* Each arc of the mark moves on its own, by its own `data-depth`, so the
           three separate as the cursor passes rather than sliding as one piece
           (Josh, 30 July 2026). */
        const layers = [...mark.querySelectorAll('[data-depth]')].map((el) => ({
          el,
          depth: Number(el.dataset.depth ?? 0),
          x: 0, y: 0, tx: 0, ty: 0,
        }));
        if (!layers.length) return;

        /* And it only responds when the cursor is actually near the mark: at
           more than PROXIMITY away nothing moves at all, and the response is
           squared so it fades in late rather than creeping. */
        const PROXIMITY = 260;
        const SCROLL_TRAVEL = 90;

        let animating = false;

        const ease = () => {
          let moving = false;
          for (const layer of layers) {
            layer.x += (layer.tx - layer.x) * 0.09;
            layer.y += (layer.ty - layer.y) * 0.09;
            layer.el.style.setProperty('--lx', `${layer.x.toFixed(2)}px`);
            layer.el.style.setProperty('--ly', `${layer.y.toFixed(2)}px`);
            if (Math.abs(layer.tx - layer.x) > 0.1 || Math.abs(layer.ty - layer.y) > 0.1) moving = true;
          }
          if (moving) requestAnimationFrame(ease);
          else animating = false;
        };

        const setTargets = (px: number, py: number) => {
          const box = mark.getBoundingClientRect();
          /* Distance from the cursor to the mark's box: zero while inside it. */
          const dx = Math.max(box.left - px, 0, px - box.right);
          const dy = Math.max(box.top - py, 0, py - box.bottom);
          const distance = Math.hypot(dx, dy);
          const closeness = Math.max(0, 1 - distance / PROXIMITY) ** 2;

          /* Direction is measured from the mark's own centre, so the arcs lean
             away from the cursor wherever it approaches from. */
          const cx = box.left + box.width / 2;
          const cy = box.top + box.height / 2;
          const ox = Math.max(-1, Math.min(1, (px - cx) / (box.width / 2 || 1)));
          const oy = Math.max(-1, Math.min(1, (py - cy) / (box.height / 2 || 1)));

          for (const layer of layers) {
            layer.tx = -ox * layer.depth * closeness;
            layer.ty = -oy * layer.depth * closeness;
          }
          if (!animating) { animating = true; requestAnimationFrame(ease); }
        };

        hero.addEventListener('mousemove', (event) => setTargets(event.clientX, event.clientY));

        /* Ease back to rest when the cursor leaves, rather than freezing. */
        hero.addEventListener('mouseleave', () => {
          for (const layer of layers) { layer.tx = 0; layer.ty = 0; }
          if (!animating) { animating = true; requestAnimationFrame(ease); }
        });

        let scrollQueued = false;
        const drift = () => {
          scrollQueued = false;
          const height = hero.offsetHeight || 1;
          const progress = Math.min(Math.max(-hero.getBoundingClientRect().top / height, 0), 1);
          mark.style.setProperty('--mark-scroll', `${(progress * SCROLL_TRAVEL).toFixed(2)}px`);
        };
        drift();
        window.addEventListener('scroll', () => {
          if (!scrollQueued) { scrollQueued = true; requestAnimationFrame(drift); }
        }, { passive: true });
        window.addEventListener('resize', drift, { passive: true });
      })();
    </script>

    <script>
      /* Scroll reveal — one IntersectionObserver, unobserve on reveal.
         Skipped entirely under reduced motion (CSS leaves .reveal visible). */
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll('.reveal');
      if (!prefersReduced && 'IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                obs.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.08, rootMargin: '0px 0px -40px 0px' },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
