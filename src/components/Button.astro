---
import Icon from './Icon.astro';

/* Button — the only interactive control style on the site.
   `primary` is solid orange (var(--cta)) and is the action colour everywhere
   except one case: Electrical's green grounds, where orange and green are both
   near-saturated complements and vibrate against each other (Josh, 29 July
   2026). There, `navy` takes over. Navy on a dark ground has almost no shape
   separation of its own (1.85:1 against Electrical's #364627), so the variant
   carries a division-accent ring to define its edge.
   Secondaries are outlines: `outline` on light backgrounds,
   `inverse-outline` on dark ones. Signature corner radius on all.
   Renders as <a> when `href` is set, else <button>. */

interface Props {
  href?: string;
  variant?: 'primary' | 'navy' | 'outline' | 'inverse-outline';
  size?: 'sm' | 'md' | 'lg';
  icon?: string;         // trailing lucide icon name
  external?: boolean;    // adds target + rel for off-site links (e.g. ServiceM8)
  block?: boolean;       // full-width
  type?: 'button' | 'submit';
  class?: string;
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  external = false,
  block = false,
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const iconSize = size === 'lg' ? 20 : size === 'sm' ? 16 : 18;
const classes = ['btn', `btn--${variant}`, `btn--${size}`, block ? 'btn--block' : '', className]
  .filter(Boolean)
  .join(' ');

const extraAttrs = href
  ? { href, ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}) }
  : { type };
---
<Tag class={classes} {...extraAttrs} {...rest}>
  <span><slot /></span>
  {icon && <Icon name={icon} size={iconSize} />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    line-height: 1;
    text-align: center;
    border: 1px solid transparent;
    border-radius: var(--radius-signature);
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition:
      filter var(--duration-base) var(--ease-standard),
      background-color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  /* sizes */
  .btn--sm { padding: 9px 16px; font-size: var(--text-sm); gap: 6px; min-height: 40px; }
  .btn--md { padding: 12px 22px; font-size: var(--text-base); gap: 8px; min-height: 46px; }
  .btn--lg { padding: 16px 30px; font-size: var(--text-md); gap: 10px; min-height: 54px; }

  .btn--block { display: flex; width: 100%; }

  /* primary — solid orange, the site CTA.
     The light hairline ring is invisible on white but separates the button
     from dark or warm-toned grounds (e.g. the Homecare ward, where the
     division colour and the CTA colour are the same family). */
  .btn--primary {
    background: var(--cta);
    color: var(--cta-fg);
    border-color: var(--cta);
    box-shadow:
      0 0 0 1.5px color-mix(in oklch, var(--white) 26%, transparent),
      var(--shadow-md);
  }
  .btn--primary:hover { filter: brightness(1.06); }

  /* navy — the action colour on grounds where orange fights the division
     colour (Electrical green). White on navy is 17:1, so the label is never the
     problem; the ring is what stops the button dissolving into a dark ground,
     and it takes the page accent so it still reads as part of that page. */
  .btn--navy {
    background: var(--ink-500);
    color: var(--white);
    border-color: color-mix(in oklch, var(--page-accent, var(--white)) 60%, transparent);
    box-shadow:
      0 0 0 1.5px color-mix(in oklch, var(--page-accent, var(--white)) 22%, transparent),
      var(--shadow-md);
  }
  .btn--navy:hover {
    background: var(--ink-400);
    border-color: var(--page-accent, var(--white));
  }

  /* outline — light backgrounds */
  .btn--outline {
    background: transparent;
    color: var(--ink-600);
    border-color: var(--ink-300);
  }
  .btn--outline:hover { background: var(--ink-50); border-color: var(--ink-400); }

  /* inverse-outline — dark backgrounds (hero, bands) */
  .btn--inverse-outline {
    background: color-mix(in oklch, var(--white) 6%, transparent);
    color: var(--white);
    border-color: var(--border-inverse);
  }
  .btn--inverse-outline:hover {
    background: color-mix(in oklch, var(--white) 14%, transparent);
    border-color: color-mix(in oklch, var(--white) 40%, transparent);
  }

  .btn:active { transform: scale(0.97); }

  @media (prefers-reduced-motion: reduce) {
    .btn { transition: none; }
    .btn:active { transform: none; }
  }

  /* comfortable touch targets on touch devices */
  @media (pointer: coarse) {
    .btn--sm { min-height: 44px; }
  }
</style>
