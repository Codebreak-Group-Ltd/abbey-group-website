---
/* Real photo in a fixed-ratio slot (cover-cropped, dimensioned for zero CLS).
   Sources are pre-optimised WebP in /public/images (sized to <=2x slot per
   build standard §5). Mirrors PhotoSlot's shape so it drops in place. */
interface Props {
  src: string;
  alt: string;
  ratio?: string;          // e.g. '3 / 2', '16 / 9', '4 / 5'
  radius?: 'lg' | 'xl' | 'none';
  eager?: boolean;         // hero/LCP image
  bordered?: boolean;
  objectPosition?: string;
  class?: string;
  width?: number;
  height?: number;
  /* Optional responsive sources. Both must be given together, or the browser has
     no basis to choose and falls back to `src` (which is the safe outcome, and
     what every page that omits them gets).

     Worth it only on an LCP image where the slot is much narrower than the file:
     the standard already requires <=2x the display slot, so most photographs on
     the site do not need this. `/lp/homecare/`'s hero does, because at a 390px
     viewport its 350px slot makes the 900w file 2.57x oversized at DPR 1 and
     1.29x at DPR 2. (Note Lighthouse's own mobile emulation runs DPR 2.625,
     where 900w is fine, so this will not show up in a Lighthouse score — it is
     a saving for real devices, not for the audit.) */
  srcset?: string;
  sizes?: string;
}
const {
  src, alt, ratio = '16 / 9', radius = 'lg', eager = false,
  bordered = true, objectPosition = 'center', class: className, width, height,
  srcset, sizes,
} = Astro.props;
const radiusVar = radius === 'none' ? '0' : `var(--radius-${radius})`;
---
<div
  class:list={['photo', bordered ? 'photo--bordered' : '', className]}
  style={`aspect-ratio:${ratio};border-radius:${radiusVar}`}
>
  <img
    src={src}
    srcset={srcset && sizes ? srcset : undefined}
    sizes={srcset && sizes ? sizes : undefined}
    alt={alt}
    width={width}
    height={height}
    style={`object-position:${objectPosition}`}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding={eager ? 'auto' : 'async'}
  />
</div>

<style>
  .photo {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--ink-50);
    box-shadow: var(--shadow-md);
  }
  .photo--bordered { border: 1px solid var(--border-subtle); }
  .photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
