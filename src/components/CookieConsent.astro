---
import Icon from './Icon.astro';
import { consentRegistry, categoryLabels, type ConsentCategory } from '../data/consent-registry.ts';

/* Cookie consent banner — build standard §6/§7, closing the launch blocker
   documented in `consent-registry.ts`, `cookies.astro` and (until 25 Aug
   2026) every LP page's tracking section.

   RENDERS NOTHING WHILE THE REGISTRY IS EMPTY, deliberately, mirroring
   `cookies.astro`'s own `hasServices` check: there is nothing to ask consent
   for yet (no real GA4/Meta IDs — see `src/lib/tracking.ts`), and a banner
   offering to manage cookies that do not exist would be the exact "policy
   describes what the site does not do" failure this architecture exists to
   prevent. The day a service is added to the registry, this banner appears
   automatically, on every page, with no other change needed.

   THREE CONSENT PATHS, EQUAL PROMINENCE (§7): Accept all / Reject non-
   essential are the same size and weight — no dark pattern where one is a
   button and the other a text link. Manage Preferences opens a panel with a
   toggle per non-necessary category; Necessary is shown but not toggleable.

   STORAGE: the consent DECISION itself lives in localStorage
   (`abbey_consent`). This is not the same "no storage" rule that governs
   `EnquiryForm.astro` — that rule is about not persisting ad-click
   attribution before consent exists to permit it. Storing the user's own
   consent choice, so they are not asked again on every page, is the
   "strictly necessary" cookie/storage every consent mechanism needs, and is
   not itself gated behind consent.

   REVOCABLE (§7): `/cookies/` links back in with `#cookie-preferences`, and
   any element anywhere with `data-open-consent` reopens the panel — see the
   script below. */

const hasServices = consentRegistry.length > 0;
const categories = [...new Set(consentRegistry.map((s) => s.category))].filter(
  (c): c is ConsentCategory => c !== 'necessary',
);
const categoryCopy: Record<string, string> = {
  analytics: 'Tells us how many people visit and which pages they use, so we can improve the site.',
  advertising: 'Measures which adverts and pages lead to an enquiry, for our own advertising only.',
};
---
{hasServices && (
  <div id="cc" class="cc" hidden data-cc>
    <div class="cc__banner" data-cc-banner>
      <p class="cc__text">
        We use cookies to run this site and, if you agree, to measure which pages and adverts work.
        See our <a href="/cookies/">cookie policy</a>.
      </p>
      <div class="cc__actions">
        <button type="button" class="cc__btn cc__btn--ghost" data-cc-manage>Manage preferences</button>
        <button type="button" class="cc__btn cc__btn--outline" data-cc-reject>Reject non-essential</button>
        <button type="button" class="cc__btn cc__btn--solid" data-cc-accept>Accept all</button>
      </div>
    </div>

    <div class="cc__panel" hidden data-cc-panel>
      <div class="cc__panel-head">
        <h2 class="cc__panel-title">Cookie preferences</h2>
        <button type="button" class="cc__close" aria-label="Close" data-cc-close><Icon name="x" size={18} /></button>
      </div>

      <div class="cc__cat">
        <div class="cc__cat-row">
          <span class="cc__cat-name">{categoryLabels.necessary}</span>
          <span class="cc__cat-fixed">Always on</span>
        </div>
        <p class="cc__cat-copy">Needed for the site and this form to work. Cannot be turned off.</p>
      </div>

      {categories.map((c) => (
        <div class="cc__cat">
          <div class="cc__cat-row">
            <span class="cc__cat-name">{categoryLabels[c]}</span>
            <label class="cc__toggle">
              <input type="checkbox" data-cc-toggle={c} />
              <span class="cc__toggle-track" aria-hidden="true"></span>
            </label>
          </div>
          <p class="cc__cat-copy">{categoryCopy[c] ?? ''}</p>
        </div>
      ))}

      <button type="button" class="cc__btn cc__btn--solid cc__save" data-cc-save>Save preferences</button>
    </div>
  </div>
)}

<style>
  .cc {
    position: fixed;
    inset: auto 0 0 0;
    z-index: var(--z-banner);
    display: flex;
    justify-content: center;
    padding: 16px;
    pointer-events: none;
  }
  .cc:not([hidden]) { pointer-events: auto; }

  .cc__banner {
    width: 100%;
    max-width: 920px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    padding: 18px 22px;
    background: var(--surface-page-dark, var(--ink-500));
    color: var(--text-body-inverse);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
  }
  .cc__text { flex: 1 1 320px; font-size: 13.5px; line-height: var(--leading-relaxed); }
  .cc__text a { color: var(--page-accent-on-dark, var(--orange-400)); font-weight: var(--weight-semibold); text-decoration: underline; }
  .cc__actions { display: flex; flex-wrap: wrap; gap: 10px; }

  .cc__btn {
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: var(--weight-bold);
    padding: 10px 16px;
    border-radius: var(--radius-signature);
    border: 1px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    min-height: 44px;
  }
  .cc__btn--solid { background: var(--cta); color: var(--cta-fg); }
  .cc__btn--solid:hover { filter: brightness(1.06); }
  .cc__btn--outline { background: transparent; color: var(--white); border-color: var(--border-inverse); }
  .cc__btn--outline:hover { background: color-mix(in oklch, var(--white) 10%, transparent); }
  .cc__btn--ghost { background: transparent; color: var(--text-muted-inverse); text-decoration: underline; border-color: transparent; padding-inline: 4px; }

  .cc__panel {
    width: 100%;
    max-width: 460px;
    margin-top: 12px;
    padding: 22px;
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
    color: var(--text-body);
  }
  .cc__panel-head { display: flex; align-items: center; justify-content: space-between; }
  .cc__panel-title { font-size: 18px; font-weight: var(--weight-bold); color: var(--text-heading); }
  .cc__close { display: inline-flex; padding: 6px; background: none; border: 0; color: var(--text-muted); cursor: pointer; min-width: 44px; min-height: 44px; align-items: center; justify-content: center; }

  .cc__cat { margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border-subtle); }
  .cc__cat:first-of-type { margin-top: 20px; padding-top: 0; border-top: 0; }
  .cc__cat-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .cc__cat-name { font-size: 14.5px; font-weight: var(--weight-semibold); color: var(--text-heading); }
  .cc__cat-fixed { font-size: 12px; font-weight: var(--weight-semibold); color: var(--text-muted); text-transform: uppercase; letter-spacing: var(--tracking-wide); }
  .cc__cat-copy { margin-top: 6px; font-size: 13px; line-height: var(--leading-relaxed); color: var(--text-muted); }

  .cc__toggle { position: relative; display: inline-flex; width: 44px; height: 26px; flex: none; }
  .cc__toggle input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .cc__toggle-track { position: absolute; inset: 0; background: var(--ink-200); border-radius: var(--radius-pill); transition: background var(--duration-fast) var(--ease-standard); }
  .cc__toggle-track::before { content: ''; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: var(--white); box-shadow: var(--shadow-sm); transition: transform var(--duration-fast) var(--ease-standard); }
  .cc__toggle input:checked + .cc__toggle-track { background: var(--cta); }
  .cc__toggle input:checked + .cc__toggle-track::before { transform: translateX(18px); }
  .cc__toggle input:focus-visible + .cc__toggle-track { outline: 2px solid var(--focus-ring); outline-offset: 2px; }

  .cc__save { width: 100%; margin-top: 20px; }

  @media (prefers-reduced-motion: reduce) {
    .cc__toggle-track, .cc__toggle-track::before { transition: none; }
  }

  /* Compact mobile variant (build standard §10): a full banner ate ~40% of a
     phone viewport in the reference build. Tighter padding, buttons still
     both full-width so Accept and Reject stay equally easy to tap.

     Manage preferences dropped its own full-width row (29 Aug 2026, SEO
     audit): that third row was the difference between the banner clearing
     the homepage hero CTA at 390px and covering it. It now sits as a plain
     inline text link above the two primary actions instead — still reachable,
     still not competing with Accept/Reject for size (rule 17), just no
     longer costing an entire row's height on the viewport that can least
     afford it. */
  @media (max-width: 640px) {
    .cc { padding: 10px; }
    .cc__banner { padding: 14px 16px; gap: 8px; }
    .cc__text { font-size: 13px; flex-basis: 100%; }
    .cc__actions { width: 100%; gap: 8px; flex-wrap: wrap; }
    .cc__btn { flex: 1 1 auto; padding: 10px 12px; }
    .cc__btn--ghost { flex: 1 1 100%; order: -1; text-align: left; padding-block: 0; }
    .cc__panel { max-width: none; }
  }
</style>

<script>
  import { loadConsentedTracking } from '../lib/tracking.ts';

  type Consent = { analytics: boolean; advertising: boolean };
  const KEY = 'abbey_consent';

  const root = document.querySelector<HTMLElement>('[data-cc]');
  if (root) {
    const banner = root.querySelector<HTMLElement>('[data-cc-banner]');
    const panel = root.querySelector<HTMLElement>('[data-cc-panel]');
    const toggles = [...root.querySelectorAll<HTMLInputElement>('[data-cc-toggle]')];

    const read = (): Consent | null => {
      try {
        const raw = localStorage.getItem(KEY);
        return raw ? JSON.parse(raw) : null;
      } catch { return null; }
    };
    const write = (c: Consent) => {
      try { localStorage.setItem(KEY, JSON.stringify({ ...c, ts: new Date().toISOString() })); } catch { /* ignore */ }
    };

    /* Google Consent Mode v2 — default-denied signals fire from BaseLayout
       before this script runs; this just updates them once a choice exists. */
    const updateConsentMode = (c: Consent) => {
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function (...args: unknown[]) { window.dataLayer!.push(args); };
      window.gtag('consent', 'update', {
        analytics_storage: c.analytics ? 'granted' : 'denied',
        ad_storage: c.advertising ? 'granted' : 'denied',
        ad_user_data: c.advertising ? 'granted' : 'denied',
        ad_personalization: c.advertising ? 'granted' : 'denied',
      });
    };

    const apply = (c: Consent) => {
      updateConsentMode(c);
      loadConsentedTracking(c);
    };

    const openPanel = () => { if (banner) banner.hidden = true; if (panel) panel.hidden = false; };
    const closePanel = () => { if (panel) panel.hidden = true; if (banner) banner.hidden = false; };
    const hideAll = () => { root.hidden = true; };
    const showBanner = () => { root.hidden = false; if (banner) banner.hidden = false; if (panel) panel.hidden = true; };

    const existing = read();
    if (existing) {
      apply(existing);
      hideAll();
    } else {
      showBanner();
    }

    root.querySelector('[data-cc-accept]')?.addEventListener('click', () => {
      const c = { analytics: true, advertising: true };
      write(c); apply(c); hideAll();
    });
    root.querySelector('[data-cc-reject]')?.addEventListener('click', () => {
      const c = { analytics: false, advertising: false };
      write(c); apply(c); hideAll();
    });
    root.querySelector('[data-cc-manage]')?.addEventListener('click', () => {
      const current = existing ?? { analytics: false, advertising: false };
      toggles.forEach((t) => { t.checked = !!current[t.dataset.ccToggle as keyof Consent]; });
      openPanel();
    });
    root.querySelector('[data-cc-close]')?.addEventListener('click', closePanel);
    root.querySelector('[data-cc-save]')?.addEventListener('click', () => {
      const c = { analytics: false, advertising: false };
      toggles.forEach((t) => { c[t.dataset.ccToggle as keyof Consent] = t.checked; });
      write(c); apply(c); hideAll();
    });

    /* Revocable (§7): the cookie policy page, or anything else, can reopen
       this with a plain `data-open-consent` attribute — no import needed. */
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('[data-open-consent]');
      if (!target) return;
      e.preventDefault();
      const current = read() ?? { analytics: false, advertising: false };
      toggles.forEach((t) => { t.checked = !!current[t.dataset.ccToggle as keyof Consent]; });
      root.hidden = false;
      openPanel();
    });
  }
</script>
