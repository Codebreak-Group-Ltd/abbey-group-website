---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { areasServed, nap } from '../data/site.ts';
import { divisions, type DivisionKey } from '../data/divisions.ts';

/* Areas covered — a full-width inverted panel: navy ground, display-serif
   heading, and a four-column ticked list of place names. The tick discs take
   the page's division accent, so the same block reads blue on Plumbing, orange
   on Homecare and so on.

   Abbey's own devices rather than a generic rounded card: the panel uses the
   signature corner geometry scaled up (three soft corners, one near-sharp
   bottom-left) and carries the division crescent as a watermark.

   Feeds `areaServed` schema from the same data (src/data/site.ts). */
interface Props {
  heading: string;
  bg?: 'white' | 'sunken';
  division?: DivisionKey;
}
const { heading, bg = 'white', division = 'group' } = Astro.props;
const mark = divisions[division].mark;
---
<Section bg={bg}>
  <div class="ac reveal">
    <img class="ac__mark" src={mark} alt="" aria-hidden="true" width="440" height="462" />
    <div class="ac__inner">
      <h2 class="ac__title">{heading}</h2>
      <p class="ac__lead"><slot /></p>

      <ul class="ac__grid">
        {areasServed.map((a) => (
          <li class="ac__item">
            <span class="ac__tick"><Icon name="check" size={13} strokeWidth={3.25} /></span>
            <span class="ac__name">{a}</span>
          </li>
        ))}
      </ul>

      <p class="ac__foot">
        Plus the villages in between, and we are based at {nap.addressLine}, {nap.locality} {nap.postcode}.
        If you are nearby and not sure whether we reach you, ask.
      </p>
    </div>
  </div>
</Section>

<style>
  .ac {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(900px 620px at 88% 8%, color-mix(in oklch, var(--page-accent-glow, var(--blue-800)) 42%, transparent) 0%, transparent 62%),
      var(--ink-500);
    /* Signature corner geometry at panel scale */
    border-radius: 34px 34px 34px 4px;
    box-shadow: var(--shadow-lg);
    padding: 56px clamp(24px, 4vw, 64px) 44px;
  }

  .ac__mark {
    position: absolute;
    right: -70px;
    bottom: -140px;
    width: 440px;
    opacity: 0.13;
    pointer-events: none;
  }

  .ac__inner { position: relative; }

  .ac__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(30px, 3.1vw, 44px);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--white);
    text-wrap: balance;
  }
  .ac__lead {
    margin-top: 14px;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--text-body-inverse);
    max-width: 62ch;
  }

  .ac__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px 32px;
    margin-top: 40px;
  }
  .ac__item { display: flex; align-items: center; gap: 12px; }

  .ac__tick {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex: none;
    border-radius: var(--radius-pill);
    background: var(--page-accent, var(--blue-500));
    /* Dark tick on the accent disc: the only option that stays legible on all
       four division colours, including the bright Electrical green. */
    color: var(--ink-500);
  }
  .ac__name {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--white);
    line-height: var(--leading-snug);
  }

  .ac__foot {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--border-inverse);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-muted-inverse);
    max-width: 78ch;
  }

  @media (max-width: 1024px) {
    .ac { padding: 44px clamp(22px, 4vw, 44px) 36px; border-radius: 28px 28px 28px 4px; }
    .ac__grid { grid-template-columns: repeat(3, 1fr); gap: 16px 28px; margin-top: 32px; }
  }
  @media (max-width: 700px) {
    .ac__grid { grid-template-columns: repeat(2, 1fr); }
    .ac__mark { width: 320px; right: -110px; bottom: -120px; }
  }
  @media (max-width: 420px) {
    .ac__grid { grid-template-columns: 1fr; gap: 14px; }
  }
</style>
