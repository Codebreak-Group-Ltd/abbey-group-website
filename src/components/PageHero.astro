---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import HeroMark from './HeroMark.astro';
import { divisions, type DivisionKey } from '../data/divisions.ts';

/* Interior-page hero — dark navy band with the division's gradient glow and
   its own single-colour crescent watermark. Optional right-column photo.
   Primary CTA stays above the mobile fold (§10).

   DIVISION MARKER (reworked 30 July 2026, Josh). The header lockup now reads
   ABBEY GROUP on every page, so this is where the visitor is told which part
   of the business they are in, and it has to be obvious. It used to be the
   small stacked sub-brand lockup inside a bordered chip — quiet, and a second
   brand mark within the same screen region as the header one (standing rule
   14). It is now typographic: the division name set large, in that division's
   accent, over a full-strength accent bar. No brand art, so nothing here can
   render a lockup the client has not supplied (rule 21) either.
   "Abbey" only prefixes the name where the sub-brand genuinely exists
   (`hasLockup`); Renovations is a service, so it reads "Renovations" alone. */
interface Props {
  eyebrow?: string;
  title: string;
  lead: string;
  trust?: string[];
  /** Sub-brand this page belongs to; drives glow, watermark and marker. */
  division?: DivisionKey;
  /** Show the division marker above the H1. */
  badge?: boolean;
  image?: string;
  imageAlt?: string;
  /** How the hero photo is sized. `panel` is the standard trade-page slot;
      `feature` gives it a wider column and a taller crop for pages whose
      photography is the selling point (Renovations). */
  media?: 'panel' | 'feature';
  /** Corner treatment for the hero photograph. Renovations passes `none`:
      square plates read as a printed monograph, rounded ones read as UI, and
      every photograph in the body of that page is square too. */
  mediaRadius?: 'xl' | 'none';
  /** How the trust row is set. `ticks` is the standard badge-check row.
      `rule` sets the same items as a hairline-divided masthead line with no
      icons: quieter, and it stops the premium page's hero opening with the same
      four green ticks as every trade page. */
  trustStyle?: 'ticks' | 'rule';
}
const {
  eyebrow,
  title,
  lead,
  trust = [],
  division = 'group',
  badge = true,
  image,
  imageAlt = '',
  media = 'panel',
  mediaRadius = 'xl',
  trustStyle = 'ticks',
} = Astro.props;

const d = divisions[division];
/* Every non-Group page gets a marker now, Renovations included: it is set
   type, not brand art, so there is nothing to fabricate. */
const showBadge = badge && division !== 'group';

/* A page with no photograph can put real content in the right-hand column
   instead (Contact's phone/email/address card, Book Online's what-to-expect).
   Beats padding out a hero with nothing in it. */
const hasAside = Astro.slots.has('aside') && !image;
const split = Boolean(image) || hasAside;
---
<section class="phero" style={`--glow:${d.glow}`} data-phero>
  <HeroMark division={division} width={420} class="phero__mark" />
  <div class:list={['container', 'phero__inner', { 'phero__inner--split': split, 'phero__inner--feature': image && media === 'feature' }]}>
    <div class="phero__copy">
      {showBadge && (
        <p class="phero__division">
          <span class="phero__division-bar" aria-hidden="true"></span>
          {d.hasLockup && <span class="phero__division-pre">Abbey</span>}
          <span class="phero__division-name">{d.label}</span>
        </p>
      )}
      {eyebrow && <p class="phero__eyebrow">{eyebrow}</p>}
      <h1 class="phero__h1">{title}</h1>
      <p class="phero__lead">{lead}</p>
      <div class="phero__cta"><slot /></div>
      {trust.length > 0 && (
        <ul class:list={['phero__trust', `phero__trust--${trustStyle}`]}>
          {trust.map((t) => (
            <li>
              {trustStyle === 'ticks' && <Icon name="badge-check" size={15} />}
              <span>{t}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
    {image && (
      <div class="phero__media">
        <Photo
          src={image}
          alt={imageAlt}
          ratio="4 / 5"
          radius={mediaRadius}
          eager
          width={media === 'feature' ? 1200 : 900}
          height={media === 'feature' ? 1500 : 1125}
        />
      </div>
    )}
    {hasAside && (
      <div class="phero__aside">
        <slot name="aside" />
      </div>
    )}
  </div>
</section>

<style>
  .phero {
    position: relative;
    overflow: hidden;
    color: var(--white);
    padding: 150px var(--container-padding) 84px;
    /* Every hero on the site is the same height, the homepage's rule verbatim.
       Before this, the hero grew with whatever its photo happened to be, so
       Renovations ran 881px against Electrical's 746px and the pages felt
       mismatched moving between them (Josh, 29 July 2026). */
    min-height: min(92vh, 820px);
    display: flex;
    align-items: center;
    background:
      radial-gradient(1000px 640px at 80% 15%, color-mix(in oklch, var(--glow) 62%, transparent) 0%, transparent 62%),
      radial-gradient(760px 540px at 6% 96%, color-mix(in oklch, var(--page-accent, var(--blue-500)) 15%, transparent) 0%, transparent 60%),
      /* Division-tinted ground rather than flat navy */
      var(--surface-page-dark, var(--ink-500));
  }
  /* Thin division rule along the top edge of the page */
  .phero::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 3px;
    background: var(--page-accent, var(--blue-500));
    opacity: 0.9;
  }
  /* The container carries the scroll drift; each of the mark's three arcs
     carries its own pointer offset (see HeroMark + BaseLayout). Transform only,
     and both motions are skipped under reduced motion. */
  .phero :global(.phero__mark) {
    position: absolute;
    right: -90px;
    bottom: -120px;
    width: 420px;
    height: auto;
    opacity: 0.22;
    pointer-events: none;
    filter: drop-shadow(0 30px 70px rgba(0, 0, 0, 0.5));
    transform: translate3d(0, var(--mark-scroll, 0px), 0);
    will-change: transform;
  }

  .phero__inner { position: relative; width: 100%; }
  .phero__copy { max-width: 760px; display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }

  .phero__inner--split {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }
  .phero__inner--split .phero__copy { max-width: 620px; }
  /* The photo slot is sized by HEIGHT, not by its ratio, so the hero height is
     the same on every page and the variants differ in width instead. The inner
     `.photo` has an inline aspect-ratio, which an explicit height simply
     overrides; its <img> is absolutely positioned and cover-cropped, so the
     framing stays right. */
  .phero__media {
    width: 100%;
    max-width: 440px;
    height: 520px;
    margin-inline: auto;
  }
  .phero__media :global(.photo) { height: 100%; }
  /* The no-photo column: sized by its content, not to the photo slot's height. */
  .phero__aside { width: 100%; max-width: 460px; margin-inline: auto; }

  /* Feature variant: the photograph carries more of the page, so it gets a
     wider column at the same height, and sits flush right rather than centred.
     Used on Renovations, where the finished work is the argument. */
  .phero__inner--feature { grid-template-columns: 1fr 0.86fr; gap: 64px; }
  .phero__inner--feature .phero__copy { max-width: 700px; }
  .phero__inner--feature .phero__media { max-width: 560px; margin-inline: auto 0; }

  /* Division marker — set type, no brand art. The accent bar carries the
     division colour at full strength (it is a graphic, not text), and the name
     uses --page-accent-on-dark, which is the 400 step and above 5:1 on every
     division's own dark ground (the 500s are 2.4-4.1:1 there and fail). */
  .phero__division {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: -4px;
  }
  .phero__division-bar {
    width: 44px;
    height: 4px;
    flex: none;
    border-radius: 2px;
    background: var(--page-accent, var(--blue-500));
  }
  .phero__division-pre {
    font-size: 13px;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-muted-inverse);
  }
  .phero__division-name {
    font-size: 17px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--page-accent-on-dark, var(--blue-400));
    white-space: nowrap;
  }

  .phero__eyebrow {
    font-size: 12.5px;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-muted-inverse);
  }
  .phero__h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(38px, 4.4vw, 62px);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
    color: var(--white);
  }
  .phero__lead { font-size: var(--text-md); line-height: var(--leading-relaxed); color: var(--text-body-inverse); max-width: 600px; }
  .phero__cta { display: flex; flex-wrap: wrap; gap: 14px; }
  /* An even 2x2 grid, not a wrapping flex row: the hero copy column is too
     narrow for four of these on one line, and a flex row orphaned the last
     item ("Rated 4.6 on Google") on a line of its own. */
  .phero__trust--ticks {
    display: grid;
    grid-template-columns: repeat(2, auto);
    justify-content: start;
    gap: 12px 28px;
    margin-top: 6px;
  }
  .phero__trust li { display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: var(--weight-semibold); color: var(--text-body-inverse); }
  .phero__trust :global(svg) { color: var(--page-accent, var(--blue-300)); flex: none; }

  /* Masthead variant: small caps under a rule, with a hairline between the two
     columns. An even 2x2 grid rather than a wrapping row (rule 12) — four of
     these on one line needs ~700px and the hero copy column is 654, so a flex
     row wrapped and left a stray divider at the start of the second line. */
  .phero__trust--rule {
    display: grid;
    grid-template-columns: auto auto;
    justify-content: start;
    align-items: baseline;
    row-gap: 4px;
    margin-top: 14px;
    padding-top: 20px;
    border-top: 1px solid color-mix(in oklch, var(--white) 20%, transparent);
  }
  .phero__trust--rule li {
    font-size: 11.5px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-muted-inverse);
    line-height: 1.9;
    padding-right: 22px;
  }
  /* Divider belongs to the right-hand column only. */
  .phero__trust--rule li:nth-child(even) {
    padding-left: 22px;
    padding-right: 0;
    border-left: 1px solid color-mix(in oklch, var(--white) 20%, transparent);
  }

  @media (max-width: 1024px) {
    /* Stacked, so the hero grows with its content again and the fixed slot
       height would only crop the photo for no reason. */
    .phero { min-height: 0; display: block; }
    .phero__media { height: auto; }
  }
  @media (max-width: 900px) {
    .phero__inner--split { grid-template-columns: 1fr; gap: 36px; }
    .phero__media { max-width: 360px; margin-inline: 0; }
    .phero__inner--feature .phero__media { max-width: 420px; margin-inline: 0; }
    .phero__aside { max-width: 100%; margin-inline: 0; }
  }
  @media (max-width: 700px) {
    .phero { padding-top: 124px; }
    .phero__cta { width: 100%; }
    .phero__cta :global(.btn) { flex: 1 1 auto; }
    .phero :global(.phero__mark) { width: 300px; right: -110px; }
    /* "Abbey PLUMBING & HEATING" at desktop size is 384px wide, which overflows
       a 390px viewport. The name keeps `nowrap` so it can never break mid-phrase
       (rule 13); the row wraps instead, so it drops to a line of its own. */
    .phero__division { flex-wrap: wrap; gap: 10px 12px; }
    .phero__division-bar { width: 32px; }
    .phero__division-name { font-size: 15px; letter-spacing: 0.1em; }
    .phero__media { max-width: 100%; }
    .phero__inner--feature .phero__media { max-width: 100%; }
    .phero__trust--ticks { grid-template-columns: 1fr; gap: 10px; }
    /* One column on a phone, so there is no divider to draw. */
    .phero__trust--rule { grid-template-columns: 1fr; }
    .phero__trust--rule li,
    .phero__trust--rule li:nth-child(even) { padding-inline: 0; border-left: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .phero :global(.phero__mark) { transform: none; will-change: auto; }
  }
</style>
