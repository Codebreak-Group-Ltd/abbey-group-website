---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { nav, nap, booking, site, routes } from '../data/site.ts';
import type { DivisionKey } from '../data/divisions.ts';
import Lockup from './Lockup.astro';

/* Site header — fixed, transparent over the (dark) hero, shrinking to a
   blurred navy bar on scroll. Navigation is the hamburger menu at ALL
   widths (a deliberate design decision — no inline desktop nav row).

   The lockup ALWAYS reads ABBEY GROUP (Josh, 30 July 2026). Only the crescent
   takes the page's division colour, and the scrolled bar takes the page's dark
   ground with an accent hairline, so the header is themed without ever
   renaming the company. Which trade you are in is announced by the hero's
   division marker, which is far louder than a small stacked descriptor was.

   The menu marks the current page, and Contact carries a permanent CTA
   treatment since it is the one action item in the list. */

interface Props {
  division?: DivisionKey;
}
const { division = 'group' } = Astro.props;

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---
<header class="hdr" data-header>
  <a class="hdr__brand" href="/" aria-label={`${site.name} — home`}>
    <Lockup division={division} descriptor="Group" size={18} />
  </a>

  <div class="hdr__right">
    <a class="hdr__phone tnum" href={`tel:${nap.phone.tel}`}>
      <Icon name="phone" size={15} />
      <span>{nap.phone.label}</span>
    </a>

    <Button href={booking.quote} external size="sm">Get a Quote</Button>

    <button
      class="hdr__menu-btn"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-btn
    >
      <span class="hdr__menu-icon" data-icon-menu><Icon name="menu" size={18} /></span>
      <span class="hdr__menu-icon" data-icon-close hidden><Icon name="x" size={18} /></span>
    </button>
  </div>

  <nav id="site-menu" class="hdr__menu" data-menu aria-label="Primary" hidden>
    <ul>
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'hdr__menu-link',
              {
                'is-active': isActive(item.href),
                /* Contact is the one action in an otherwise navigational list,
                   so it is styled as one permanently rather than only when you
                   are on it (Josh, 30 July 2026). */
                'is-cta': item.href === routes.contact,
              },
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <span>{item.label}</span>
            {isActive(item.href) && <span class="hdr__menu-dot" aria-hidden="true"></span>}
          </a>
        </li>
      ))}
    </ul>
    <div class="hdr__menu-foot">
      <a class="hdr__menu-phone tnum" href={`tel:${nap.phone.tel}`}>
        <Icon name="phone" size={16} /> {nap.phone.label}
      </a>
      <Button href={booking.quote} external size="md" block>Get a Quote</Button>
    </div>
  </nav>
</header>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px var(--container-padding);
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      padding 400ms var(--ease-out),
      background-color 400ms var(--ease-out),
      border-color 400ms var(--ease-out),
      backdrop-filter 400ms var(--ease-out);
  }

  /* Scrolled bar takes the page's own dark ground, so the header reads as part
     of the division rather than a generic navy strip. */
  .hdr[data-scrolled] {
    padding-block: 10px;
    background: color-mix(in oklch, var(--surface-page-dark, var(--ink-500)) 92%, transparent);
    backdrop-filter: blur(16px);
    border-bottom-color: color-mix(in oklch, var(--page-accent, var(--white)) 38%, transparent);
  }

  .hdr__brand { display: flex; align-items: center; }
  /* Shrink the whole lockup on scroll by driving its one size variable. */
  .hdr[data-scrolled] .hdr__brand :global(.lu) { --lu-size: 15px; --lu-mark: 35px; }

  .hdr__right { display: flex; align-items: center; gap: 16px; }

  .hdr__phone {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    white-space: nowrap;   /* never break the number across two lines */
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--white);
  }
  .hdr__phone :global(svg) { color: var(--blue-300); }
  .hdr__phone:hover { color: var(--blue-200); }

  .hdr__menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-signature);
    border: 1px solid color-mix(in oklch, var(--white) 18%, transparent);
    background: color-mix(in oklch, var(--white) 6%, transparent);
    color: var(--white);
    transition: background-color var(--duration-base) var(--ease-standard);
  }
  .hdr__menu-btn:hover { background: color-mix(in oklch, var(--white) 12%, transparent); }
  .hdr__menu-icon { display: inline-flex; }

  .hdr__menu {
    position: absolute;
    top: 100%;
    right: var(--container-padding);
    margin-top: 8px;
    min-width: 244px;
    padding: 10px;
    background: color-mix(in oklch, var(--ink-500) 96%, transparent);
    backdrop-filter: blur(16px);
    border: 1px solid color-mix(in oklch, var(--white) 12%, transparent);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
  }
  .hdr__menu[hidden] { display: none; }
  .hdr__menu ul { display: flex; flex-direction: column; gap: 4px; }

  .hdr__menu-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    border-radius: var(--radius-md);
    font-size: 14.5px;
    font-weight: var(--weight-semibold);
    color: color-mix(in oklch, var(--white) 85%, var(--ink-500));
    transition: background-color var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }
  .hdr__menu-link:hover { background: color-mix(in oklch, var(--white) 8%, transparent); color: var(--white); }

  /* CURRENT PAGE — a tinted ground, a full-strength accent bar down the left
     edge and a dot on the right. Deliberately three signals, not one: the
     accent alone was a single 300-shade colour change that read as a hover
     state on some pages (Josh, 30 July 2026). The bar and dot use the page's
     own accent, so the marker is the same colour as everything else on it. */
  .hdr__menu-link.is-active {
    background: color-mix(in oklch, var(--page-accent, var(--blue-500)) 18%, transparent);
    color: var(--white);
    box-shadow: inset 3px 0 0 var(--page-accent, var(--blue-500));
  }
  .hdr__menu-dot {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: var(--radius-pill);
    background: var(--page-accent, var(--blue-500));
  }

  /* CONTACT — permanently styled as the action in the list. Orange, the one CTA
     colour site-wide (standing rule 3), so it never competes with the accent
     marker above even when you are on /contact/ and both apply. */
  .hdr__menu-link.is-cta {
    margin-top: 6px;
    background: var(--cta);
    color: var(--cta-fg);
    box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--white) 22%, transparent);
    font-weight: var(--weight-bold);
  }
  .hdr__menu-link.is-cta:hover {
    background: color-mix(in oklch, var(--cta) 88%, var(--white));
    color: var(--cta-fg);
  }
  .hdr__menu-link.is-cta.is-active {
    box-shadow: inset 3px 0 0 var(--white), inset 0 0 0 1px color-mix(in oklch, var(--white) 22%, transparent);
  }
  .hdr__menu-link.is-cta .hdr__menu-dot { background: var(--white); }

  @media (prefers-reduced-motion: reduce) {
    .hdr, .hdr__logo img { transition: none; }
  }

  /* Menu opening animation */
  @media (prefers-reduced-motion: no-preference) {
    .hdr__menu:not([hidden]) { animation: menuIn 200ms var(--ease-out); }
  }
  @keyframes menuIn {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: none; }
  }

  /* The menu's phone + CTA block is for the mobile panel only. */
  .hdr__menu-foot { display: none; }

  /* Hide the header phone link on small screens: the number lives in the menu
     panel instead, so it can never be squeezed onto two lines. */
  @media (max-width: 700px) {
    .hdr__phone { display: none; }

    /* Not sticky on mobile. It sits over the top of the hero and scrolls away,
       giving content the full viewport; ScrollTop.astro covers getting back up. */
    .hdr {
      position: absolute;
      transition: none;
    }
    .hdr[data-scrolled] {
      padding-block: 18px;
      background: transparent;
      backdrop-filter: none;
      border-bottom-color: transparent;
    }
    .hdr[data-scrolled] .hdr__brand :global(.lu) { --lu-size: 18px; --lu-mark: 42px; }

    /* Full-width panel with comfortable targets, rather than a narrow dropdown
       that was fiddly to read and tap. */
    .hdr__menu {
      left: var(--container-padding);
      right: var(--container-padding);
      min-width: 0;
      padding: 12px;
      max-height: calc(100vh - 110px);
      overflow-y: auto;
    }
    .hdr__menu ul { gap: 2px; }
    .hdr__menu-link {
      font-size: 16.5px;
      padding: 14px 16px;
      border-radius: var(--radius-md);
    }
    .hdr__menu-foot {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 12px;
      padding: 14px 8px 6px;
      border-top: 1px solid color-mix(in oklch, var(--white) 14%, transparent);
    }
    .hdr__menu-phone {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      white-space: nowrap;
      font-size: 16px;
      font-weight: var(--weight-bold);
      color: var(--white);
    }
    .hdr__menu-phone :global(svg) { color: var(--page-accent, var(--blue-300)); }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const iconMenu = document.querySelector<HTMLElement>('[data-icon-menu]');
  const iconClose = document.querySelector<HTMLElement>('[data-icon-close]');

  /* Scroll-shrink (passive, rAF-throttled) */
  if (header) {
    let ticking = false;
    const update = () => {
      if (window.scrollY > 40) header.setAttribute('data-scrolled', '');
      else header.removeAttribute('data-scrolled');
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
  }

  /* Menu toggle + keyboard/outside-click handling */
  if (btn && menu && iconMenu && iconClose) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      iconMenu.hidden = open;
      iconClose.hidden = !open;
      if (open) {
        const first = menu.querySelector<HTMLAnchorElement>('a');
        first?.focus();
      }
    };

    btn.addEventListener('click', () => setOpen(menu.hidden));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        btn.focus();
      }
    });

    document.addEventListener('click', (e) => {
      if (menu.hidden) return;
      const t = e.target as Node;
      if (!menu.contains(t) && !btn.contains(t)) setOpen(false);
    });

    // Any nav click closes the menu.
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => setOpen(false)),
    );
  }
</script>
