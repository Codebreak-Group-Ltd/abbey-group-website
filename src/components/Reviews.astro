---
import Section from './Section.astro';
import Eyebrow from './Eyebrow.astro';
import Stars from './Stars.astro';
import Icon from './Icon.astro';
import type { Review } from '../data/site.ts';
import { routes } from '../data/site.ts';

interface Props {
  eyebrow?: string;
  heading: string;
  reviews: Review[];
  readAllHref?: string;
  readAllLabel?: string;
  /* Open the "read all" link in a new tab. OFF by default, because on a site page
     it points at `/reviews/` and staying in the same tab is correct there.

     The landing pages turn it on: their link goes to the Google profile, and a
     competing link that navigates a paid visitor off the page is the one thing an
     LP cannot afford. A new tab keeps the proof available without losing them. */
  readAllExternal?: boolean;
  /* Set explicitly on every page: adjacent sections must never share a
     background (see tools/audit.mjs, which fails the build if they do). */
  bg?: 'white' | 'sunken';
}
const {
  eyebrow = "Don't take our word for it",
  heading,
  reviews,
  readAllHref = routes.reviews,
  readAllLabel = 'Read all our reviews',
  readAllExternal = false,
  bg = 'white',
} = Astro.props;

/* Pick a column count that divides the review count exactly, so the grid never
   leaves a ragged final row. Falls back to 3 for awkward counts (5, 7, 11...). */
const n = reviews.length;
const cols = [4, 3, 2].find((c) => n % c === 0) ?? 3;

/* Cards invert against the section ground so they always separate. */
const cardBg = bg === 'white' ? 'var(--surface-sunken)' : 'var(--white)';
---
<Section bg={bg}>
  <div class="rv__head reveal">
    <div>
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 class="rv__title">{heading}</h2>
    </div>
    <a
      class="rv__all"
      href={readAllHref}
      target={readAllExternal ? '_blank' : undefined}
      rel={readAllExternal ? 'noopener noreferrer' : undefined}
    >
      {readAllLabel} <Icon name="arrow-right" size={15} />
    </a>
  </div>

  <ul class="rv__grid reveal" style={`--rv-cols:${cols};--rv-card-bg:${cardBg}`}>
    {reviews.map((r) => (
      <li class="rv__card">
        <Stars />
        <blockquote class="rv__quote">{r.quote}</blockquote>
        <div class="rv__meta">
          <span class="rv__name">{r.name}</span>
          <span class="rv__src">{r.source}</span>
        </div>
      </li>
    ))}
  </ul>
</Section>

<style>
  .rv__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 40px;
  }
  .rv__title {
    font-size: clamp(32px, 3.2vw, 46px);
    color: var(--text-heading);
    margin-top: 10px;
  }
  .rv__all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    font-weight: var(--weight-bold);
    color: var(--text-link);
    white-space: nowrap;
  }
  .rv__all:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* Columns are set from the review count so the last row is never short:
     8 reviews sit 4x2, 6 sit 3x2, 3 sit in a single row. */
  .rv__grid {
    display: grid;
    grid-template-columns: repeat(var(--rv-cols, 4), 1fr);
    gap: 16px;
    align-items: start;
  }
  .rv__card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--rv-card-bg, var(--white));
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 22px 22px 20px;
    height: 100%;
  }
  .rv__quote {
    margin: 0;
    font-size: 14px;
    line-height: var(--leading-relaxed);
    color: var(--text-body);
    flex: 1;
  }
  .rv__meta { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
  .rv__name { font-size: 13.5px; font-weight: var(--weight-bold); color: var(--text-heading); }
  .rv__src { font-size: 12.5px; color: var(--text-muted); }

  @media (max-width: 1024px) {
    .rv__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .rv__grid { grid-template-columns: 1fr; }
  }
</style>
